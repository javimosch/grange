// serverbac.src — RBAC route + write-route classifier, split out of serve.src
// to keep every file under the project's 500-line limit.
//
// RBAC is opt-in and retrocompatible: existing tokens have no role record and
// default to "rw" (read-write). A tenant can issue additional read-only ("ro")
// tokens via POST /tokens; those tokens can read (GET) but not write (POST
// /put /del /bulk /index /cold /compact /shutdown). The admin token is never
// read-only.

// srv_spawn_follower starts a --follow replica on port+1 and sets g_read_proxy
// to it, giving real read concurrency (the follower is a separate process
// with its own actor loop). Called when GRANGE_CONCURRENT_READS=1 is set and
// no manual --read-proxy is configured. The follower inherits the same db
// dir and token. If the spawn fails, the primary continues without a proxy
// (degrades gracefully to single-actor, same as a proxy being down).
func srv_spawn_follower(db, port, token) {
    fport := port + 1
    g_read_proxy = "http://127.0.0.1:" + str(fport)
    exe := srv_argv_flag0()
    if len(exe) == 0 { exe = "grange" }
    // exec() runs via system() which waits for the shell to exit. Using
    // nohup + & backgrounds the follower so the shell returns immediately
    // and the follower keeps running as a daemon.
    cmd := "nohup " + exe + " serve --db '" + db + "' --port " + str(fport) + " --token '" + token + "' --follow >/dev/null 2>&1 &"
    code, _, err := exec(cmd)
    if code != 0 {
        write(2, "{\"event\":\"concurrent_reads\",\"status\":\"follower_spawn_failed\",\"port\":" + str(fport) + ",\"err\":\"" + jesc(err) + "\"}\n")
        g_read_proxy = ""
        return
    }
    write(2, "{\"event\":\"concurrent_reads\",\"status\":\"follower_spawned\",\"port\":" + str(fport) + "}\n")
}

// srv_argv_flag0 returns argv[0] — the path to the running binary.
func srv_argv_flag0() (v) {
    v = ""
    a := args()
    if len(a) > 0 { v = a[0] }
}

// srv_is_write returns 1 if the request targets a write route (POST /put
// /del /bulk /index /cold /compact /shutdown). Used by the RBAC gate to block
// read-only tokens from mutating the database.
func srv_is_write(req) (yes) {
    yes = 0
    if req.method != "POST" { return }
    if srv_route(req.path, "/put") { yes = 1  return }
    if srv_route(req.path, "/del") { yes = 1  return }
    if srv_route(req.path, "/bulk") { yes = 1  return }
    if srv_route(req.path, "/index") { yes = 1  return }
    if srv_route(req.path, "/cold") { yes = 1  return }
    if srv_route(req.path, "/compact") { yes = 1  return }
    if srv_route(req.path, "/shutdown") { yes = 1  return }
}

// srv_tokens_route handles POST /tokens — issue an additional token for the
// caller's tenant with a role. A tenant authenticates with their existing
// token; admin can issue for any tenant via ?tenant=<tid>.
// Body: {"role":"ro"} (default "rw"). Returns (res, handled).
func srv_tokens_route(req) (res, handled) {
    res = srv_err("404 Not Found", "not-found", "unreachable")
    handled = 1
    if req.method == "POST" && (srv_route(req.path, "/tokens")) {
        role, tid := srv_role(req)
        if len(role) == 0 {
            res = srv_err("401 Unauthorized", "auth", "missing or wrong bearer token")
            return
        }
        target_tid := tid
        if role == "admin" {
            target_tid = srv_body_str(req, "tenant")
            if len(target_tid) == 0 { target_tid = query(req, "tenant") }
            if len(target_tid) == 0 {
                res = srv_err("400 Bad Request", "input", "admin must specify ?tenant=<tid>")
                return
            }
        }
        new_role := srv_body_str(req, "role")
        if len(new_role) == 0 { new_role = "rw" }
        if new_role != "rw" && new_role != "ro" {
            res = srv_err("400 Bad Request", "input", "role must be \"rw\" or \"ro\"")
            return
        }
        ntok := tn_issue_token(target_tid, new_role)
        res = srv_ok("{\"token\":\"" + ntok + "\",\"role\":\"" + new_role + "\",\"tenant\":\"" + jesc(target_tid) + "\"}")
        return
    }
    handled = 0
}
