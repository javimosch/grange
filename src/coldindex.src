// grange cold secondary indexes — M20. See cold.src for the page/run layout.

// ---- cold secondary indexes (M20) ----
//
// An index page holds (value-token, id) pairs for values whose hash lands in
// partition j, so ONE page read answers an equality lookup per run:
//   crun-<gen>-<rid>-x<slug>-i<j>.grg    slug = sha256(field)[:8]
// The run manifest records which fields it indexed, so a run written before a
// declaration is detected and the query falls back to a scan (correct, slower).
// Candidates from index pages are always re-verified through cold_get (a newer
// run or the memtable may have changed or deleted the doc), so results are exact.

var g_cifields = []string{}
var g_run_fields = []string{}
var g_run_iparts = []int{}

// Index partitions per run (Q). Fixed and small: a lookup reads ONE index
// page, and a build makes Q/GRANGE_IDX_BATCH cheap passes. Recorded per run in
// the manifest so changing the env never invalidates existing pages.
func cold_idx_parts() (q) {
    q = parse_int(env("GRANGE_IDX_PARTS"))
    if q == 0 { q = 16 }
    p := 1
    while p < q { p = p * 2 }
    q = p
}

func cold_fslug(f) (s) {
    s = substr(sha256(f), 0, 8)
}

func cold_idx_name(rid, f, j) (s) {
    s = "crun-" + gr_pad6(g_gen) + "-" + gr_pad6(rid) + "-x" + cold_fslug(f) + "-i" + gr_pad6(j) + ".grg"
}

func cold_idx_save() (ok) {
    ok = 1
    if write_file(gr_dir() + "/cold.idx", join(g_cifields, "\n") + "\n") < 0 { ok = 0 }
}

func cold_idx_load() {
    g_cifields = []string{}
    content := read_file(gr_dir() + "/cold.idx")
    if len(content) == 0 { return }
    lines := split(content, "\n")
    i := 0
    while i < len(lines) {
        if len(lines[i]) > 0 { g_cifields = append(g_cifields, lines[i]) }
        i = i + 1
    }
}

func cold_is_indexed(f) (yes) {
    yes = 0
    i := 0
    while i < len(g_cifields) {
        if g_cifields[i] == f { yes = 1  return }
        i = i + 1
    }
}

// cold_idx_ready: every run carries index pages for f (else queries must scan).
func cold_idx_ready(f) (yes) {
    yes = 0
    if cold_is_indexed(f) == 0 { return }
    i := 0
    while i < len(g_run_fields) {
        if contains("," + g_run_fields[i] + ",", "," + f + ",") == false { return }
        i = i + 1
    }
    yes = 1
}

// cold_write_idx_pages writes index pages for `field` from an id->doc map
// (used at flush: the memtable is bounded, so RAM is bounded).
func cold_write_idx_pages(rid, field, docs) (ok) {
    ok = 1
    pcount := cold_idx_parts()
    ids := keys(docs)
    j := 0
    while j < pcount {
        lines := []string{}
        nrec := 0
        i := 0
        while i < len(ids) {
            tok := ix_field_tok(docs[ids[i]], field)
            if len(tok) > 0 {
                if (cold_hash(tok) & (pcount - 1)) == j {
                    lines = append(lines, "p|" + tok)
                    lines = append(lines, ids[i])
                    nrec = nrec + 1
                }
            }
            i = i + 1
        }
        if gr_write_recfile(gr_dir() + "/" + cold_idx_name(rid, field, j), lines, nrec) == 0 { ok = 0  return }
        j = j + 1
    }
}

// cold_idx_batch: partitions built per pass (RAM/IO trade-off for index builds
// over an already-written run).
func cold_idx_batch() (b) {
    b = parse_int(env("GRANGE_IDX_BATCH"))
    if b == 0 { b = 4 }
}

func cold_scratch_name(rid, field, k, j) (s) {
    s = "sx-" + gr_pad6(rid) + "-" + cold_fslug(field) + "-" + gr_pad6(k) + "-" + gr_pad6(j) + ".tmp"
}

// cold_build_indexes builds index pages for a run whose DATA pages already
// exist. Two phases so neither RAM nor CPU blows up:
//   1. one pass over the data pages extracting "<token>\t<id>" scratch files
//      (the JSON is parsed exactly once per doc);
//   2. Q/batch passes over those cheap scratch files, writing the index pages
//      for a batch of partitions at a time (RAM = batch/Q of the entries).
func cold_build_indexes(rid, pcount) (ok) {
    ok = 1
    q := cold_idx_parts()
    fi := 0
    while fi < len(g_cifields) {
        field := g_cifields[fi]
        // phase 1: one pass over the data pages, writing each entry into the
        // scratch file of its value partition (so phase 2 reads it exactly once)
        k := 0
        while k < pcount {
          arena {
            pbody, rok := gr_load_recbody(gr_dir() + "/" + cold_page_name(rid, k))
            parts := make(map[int][]string)
            pn := make(map[int]int)
            if rok == 1 {
                pos := 0
                while true {
                    ln, next, more := gr_next_line(pbody, pos)
                    if more == 0 { break }
                    pos = next
                    if has_prefix(ln, "p|") {
                        dline, dnext, dmore := gr_next_line(pbody, pos)
                        if dmore == 0 { break }
                        pos = dnext
                        tok := ix_field_tok(dline, field)
                        if len(tok) > 0 {
                            j := cold_hash(tok) & (q - 1)
                            parts[j] = append(parts[j], tok + "\t" + substr(ln, 2, len(ln)))
                            pn[j] = pn[j] + 1
                        }
                    }
                }
            }
            j := 0
            while j < q {
                if pn[j] > 0 {
                    if gr_write_recfile(gr_dir() + "/" + cold_scratch_name(rid, field, k, j), parts[j], pn[j]) == 0 { ok = 0 }
                }
                j = j + 1
            }
          }
          if ok == 0 { return }
          k = k + 1
        }
        // phase 2: per partition, merge its scratch files into one index page
        j := 0
        while j < q {
          arena {
            lines := []string{}
            n := 0
            k = 0
            while k < pcount {
                sbody, sok := gr_load_recbody(gr_dir() + "/" + cold_scratch_name(rid, field, k, j))
                if sok == 1 {
                    pos := 0
                    while true {
                        ln, next, more := gr_next_line(sbody, pos)
                        if more == 0 { break }
                        pos = next
                        tabp := index(ln, "\t")
                        if tabp > 0 {
                            lines = append(lines, "p|" + substr(ln, 0, tabp))
                            lines = append(lines, substr(ln, tabp + 1, len(ln)))
                            n = n + 1
                        }
                    }
                }
                k = k + 1
            }
            if gr_write_recfile(gr_dir() + "/" + cold_idx_name(rid, field, j), lines, n) == 0 { ok = 0 }
          }
          if ok == 0 { return }
          j = j + 1
        }
        // drop the scratch files
        k = 0
        while k < pcount {
            j = 0
            while j < q {
                remove(gr_dir() + "/" + cold_scratch_name(rid, field, k, j))
                j = j + 1
            }
            k = k + 1
        }
        fi = fi + 1
    }
}

// cold_idx_candidates collects candidate ids for field==token from every run's
// index page plus the memtable. Unverified: the caller re-checks each doc.
func cold_idx_candidates(field, token) (ids) {
    ids = []string{}
    seen := make(map[string]int)
    r := 0
    while r < len(g_run_rid) {
        pcount := g_run_iparts[r]
        if pcount < 1 { pcount = cold_idx_parts() }
        j := cold_hash(token) & (pcount - 1)
        body, ok := gr_load_recbody(gr_dir() + "/" + cold_idx_name(g_run_rid[r], field, j))
        if ok == 1 {
            pos := 0
            while true {
                ln, next, more := gr_next_line(body, pos)
                if more == 0 { break }
                pos = next
                if has_prefix(ln, "p|") {
                    idline, inext, imore := gr_next_line(body, pos)
                    if imore == 0 { break }
                    pos = inext
                    if substr(ln, 2, len(ln)) == token {
                        if has(seen, idline) == false {
                            seen[idline] = 1
                            ids = append(ids, idline)
                        }
                    }
                }
            }
        }
        r = r + 1
    }
    // unflushed writes live only in the memtable
    mids := keys(g_mem)
    i := 0
    while i < len(mids) {
        if ix_field_tok(g_mem[mids[i]], field) == token {
            if has(seen, mids[i]) == false {
                seen[mids[i]] = 1
                ids = append(ids, mids[i])
            }
        }
        i = i + 1
    }
}

// cold_idx_usable finds the first equality clause on a ready cold index.
// Returns (field, token, ok) — token is the raw JSON form actually stored.
func cold_idx_usable(fields, ops, vals) (field, token, ok) {
    field = ""
    token = ""
    ok = 0
    if g_cold == 0 { return }
    i := 0
    while i < len(fields) {
        if ops[i] == "=" && cold_idx_ready(fields[i]) == 1 {
            field = fields[i]
            // stored tokens are raw JSON: a string value carries its quotes
            token = "\"" + vals[i] + "\""
            if len(cold_idx_candidates(field, token)) == 0 { token = vals[i] }
            ok = 1
            return
        }
        i = i + 1
    }
}

// cold_idx_resolve turns candidate ids into verified results with at most ONE
// read per touched page per run (never more reads than a full scan): the
// memtable resolves for free, then each run's pages are grouped and read once.
func cold_idx_resolve(cands, fields, ops, vals, limit, countonly) (items, n) {
    items = []string{}
    n = 0
    pending := []string{}
    i := 0
    while i < len(cands) {
        id := cands[i]
        if has(g_tomb, id) == false {
            if has(g_mem, id) {
                if wh_match(g_mem[id], fields, ops, vals) == 1 {
                    if countonly == 0 { items = append(items, "{\"id\":\"" + jesc(id) + "\",\"doc\":" + g_mem[id] + "}") }
                    n = n + 1
                }
            } else {
                pending = append(pending, id)
            }
        }
        i = i + 1
    }
    r := len(g_run_rid) - 1
    while r >= 0 {
        if len(pending) == 0 { return }
        if countonly == 0 && limit > 0 && n >= limit { return }
        pcount := g_run_pages[r]
        bypage := make(map[int][]string)
        touched := []int{}
        i = 0
        while i < len(pending) {
            k := cold_hash(pending[i]) & (pcount - 1)
            if len(bypage[k]) == 0 { touched = append(touched, k) }
            bypage[k] = append(bypage[k], pending[i])
            i = i + 1
        }
        still := []string{}
        t := 0
        while t < len(touched) {
            k := touched[t]
            body, rok := gr_load_recbody(gr_dir() + "/" + cold_page_name(g_run_rid[r], k))
            pput := make(map[string]string)
            pdel := make(map[string]int)
            if rok == 1 {
                pos := 0
                while true {
                    ln, next, more := gr_next_line(body, pos)
                    if more == 0 { break }
                    pos = next
                    if has_prefix(ln, "p|") {
                        dline, dnext, dmore := gr_next_line(body, pos)
                        if dmore == 0 { break }
                        pos = dnext
                        pput[substr(ln, 2, len(ln))] = dline
                    } else {
                        pdel[substr(ln, 2, len(ln))] = 1
                    }
                }
            }
            pend := bypage[k]
            i = 0
            while i < len(pend) {
                id := pend[i]
                if has(pput, id) {
                    if wh_match(pput[id], fields, ops, vals) == 1 {
                        if countonly == 0 {
                            if limit > 0 && n >= limit {
                                i = len(pend)
                            } else {
                                items = append(items, "{\"id\":\"" + jesc(id) + "\",\"doc\":" + pput[id] + "}")
                                n = n + 1
                            }
                        } else {
                            n = n + 1
                        }
                    }
                } else if has(pdel, id) == false {
                    still = append(still, id)
                }
                i = i + 1
            }
            t = t + 1
        }
        pending = still
        r = r - 1
    }
}

// q_cold_index answers a cold query through an index page when one covers an
// equality clause. Candidates are re-verified against the authoritative doc
// (newer run / memtable / tombstone), so results are exact.
// Returns (items, n, used) — used=0 means the caller must scan.
func q_cold_index(fields, ops, vals, limit, countonly) (items, n, used) {
    items = []string{}
    n = 0
    used = 0
    field, token, ok := cold_idx_usable(fields, ops, vals)
    if ok == 0 { return }
    used = 1
    if countonly == 1 {
        // counting leaks nothing: candidates and pages die with the block
        arena {
            xi, xn := cold_idx_resolve(cold_idx_candidates(field, token), fields, ops, vals, 0, 1)
            n = xn
        }
        return
    }
    items, n = cold_idx_resolve(cold_idx_candidates(field, token), fields, ops, vals, limit, countonly)
}
