// servereset.src — periodic arena reset, split out of serve.src to keep
// every file under the project's 500-line limit.
//
// A long-lived actor retains memory per request (M37: ~8-16 kB), and grange's
// only answer was the RSS watchdog RESTARTING the process — which drops every
// in-flight request and every parked watcher. poche, which embeds this same
// engine, does something gentler: it calls gr_reset() every N requests, after
// the response is written. grange has gr_reset() and never called it.
//
// gr_reset() frees the arena, and what survives that is narrow. Measured:
// string LITERALS, env() values and args() values survive (they are backed by
// memory outside the arena); COMPUTED strings are silently corrupted — a
// concatenated "tok-secret123-end" came back as "1", with no crash. So anything
// re-derived here must come from args()/env() DIRECTLY, never from the parsed
// flag struct, whose internal maps are themselves computed.
func srv_argv_flag(name) (v) {
    v = ""
    a := args()
    i := 0
    while i < len(a) {
        if a[i] == name && i + 1 < len(a) {
            v = a[i + 1]
            return
        }
        i = i + 1
    }
}

// OFF by default, and that is a measurement result rather than caution. The
// reset lowers the SUSTAINED level a lot (measured over 6000 requests on a 20k
// collection: 46->126 MB without, 23->61 MB with) but each reset is followed by
// a reload of whatever the next request touches, and that spike is proportional
// to the collection. Sampled finely on a three-collection database the peak was
// WORSE with resets (86 MB -> 105 MB). Which effect dominates depends on
// collection size and run length, so the operator opts in.
func srv_reset_every() (n) {
    n = parse_int(env("GRANGE_RESET_EVERY"))
}

var g_req_count = 0
var g_reset_ok = 0
var g_resets = 0

// srv_maybe_reset drops the accumulated arena when it is safe to do so:
// nothing staged, no watcher parked (they hold collection names), and only
// between requests — never with a response half-built.
func srv_maybe_reset() {
    every := srv_reset_every()
    if every == 0 { return }
    if g_reset_ok == 0 { return }
    if g_req_count < every { return }
    if g_pend_recs > 0 { return }
    if len(g_w_fd) > 0 { return }
    if g_park > 0 { return }
    if gr_reset() == 0 { return }
    // re-derive from argv/env only: everything else was just freed
    g_srv_db = srv_argv_flag("--db")
    if len(g_srv_db) == 0 { g_srv_db = env("GRANGE_DB") }
    tok := srv_argv_flag("--token")
    if len(tok) == 0 { tok = env("GRANGE_TOKEN") }
    g_srv_token = tok
    tn_load_cache()
    g_req_count = 0
    g_resets = g_resets + 1
    write(2, "{\"event\":\"arena_reset\",\"resets\":" + str(g_resets) + "}\n")
}
