// grange serve — the HTTP/JSON face (the seed of the hosted version).
//
// SINGLE-ACTOR BY CONSTRUCTION: the server is a sequential accept loop with
// zero goroutines — one request at a time touches the memtable, so there is
// nothing to race on and `machin check`'s inferred race analysis stays clean.
// (machweb's `serve` spawns a goroutine per connection; we deliberately call
// its machweb_handle directly instead.)
//
// Auth: every route except /health needs Authorization: Bearer <token>
// (or ?token=). Token comes from --token / GRANGE_TOKEN, else one is
// generated and printed at startup.

var g_srv_token = ""
var g_srv_db = ""
// parked long-poll watchers (single-actor: plain parallel slices, no locks)
var g_w_fd = []int{}
var g_w_tid = []string{}
var g_w_db = []string{}
var g_w_coll = []string{}
var g_w_since = []int{}
var g_w_deadline = []int{}
var g_park = 0
var g_srv_follow = 0
var g_shutdown = 0
func srv_json(status, body) (res) {
    res = response(status, "application/json", body)
}

func srv_err(status, etype, msg) (res) {
    res = srv_json(status, "{\"ok\":false,\"error\":{\"type\":\"" + etype + "\",\"message\":\"" + jesc(msg) + "\"}}")
}

func srv_ok(data) (res) {
    res = srv_json("200 OK", "{\"ok\":true,\"data\":" + data + "}")
}

// srv_role resolves the caller: ("admin","") | ("tenant",tid) | ("","").
func srv_role(req) (role, tid) {
    role = ""
    tid = ""
    tok := query(req, "token")
    h := header(req, "authorization")
    if has_prefix(h, "Bearer ") { tok = substr(h, 7, len(h)) }
    if len(tok) == 0 { return }
    if tok == g_srv_token { role = "admin"  return }
    if has(g_tenants, tok) == false && g_srv_follow == 1 {
        // a tenant created on the primary after this follower started:
        // refresh _sys from disk and rescan before rejecting
        uok, uerr := gr_use(g_srv_db, "_sys")
        if uok == 1 { gr_refresh() }
        tn_load_cache()
    }
    if has(g_tenants, tok) {
        role = "tenant"
        tid = g_tenants[tok]
    }
}

// srv_body_field pulls a raw JSON token out of the request body ("" if absent).
// srv_route matches a route exactly, or with a query string. `req.path` carries
// the query string, which is why the naive form was has_prefix(path, "/count") —
// and that also matched /counter and /countXYZ, so a mistyped route returned a
// plausible answer and the caller never learned. For an agent-first API that is
// worse than an error: it teaches a wrong URL by rewarding it.
//
// /health and a few others already did this correctly; the rest did not, which
// is how the inconsistency hid.
func srv_route(p, r) (yes) {
    // returns a BOOL: every call site uses it directly as a condition
    // (`if req.method == "GET" && srv_route(...)`), the way has_prefix did
    yes = false
    if p == r { yes = true  return }
    if has_prefix(p, r + "?") { yes = true }
}

func srv_body_field(req, f) (tok) {
    tok = ""
    v, err := json_get(req.body, "." + f)
    if len(err) == 0 { tok = v }
}

// srv_body_str is srv_body_field with the quotes of a JSON string stripped.
func srv_body_str(req, f) (s) {
    s = srv_body_field(req, f)
    if len(s) > 1 && charat(s, 0) == "\"" { s = substr(s, 1, len(s) - 1) }
}

// srv_coll resolves the request's collection (?coll= or body "coll"),
// defaulting to "default", and switches the engine to it under `root`.
func srv_use(req, root) (ok) {
    c := query(req, "coll")
    if len(c) == 0 { c = srv_body_str(req, "coll") }
    if len(c) == 0 { c = "default" }
    ok = 0
    if valid_id(c) == 0 { return }
    if c == "_sys" { return }
    uok, uerr := gr_use(root, c)
    ok = uok
}

func srv_handle(req) (res) {
    if req.method == "GET" && (req.path == "/" || req.path == "/index.html") {
        res = ok_html(landing_html())
        return
    }
    if req.method == "GET" && has_prefix(req.path, "/llms.txt") {
        res = ok_text(llms_txt())
        return
    }
    if req.method == "GET" && srv_route(req.path, "/guide") {
        res = ok_text(llms_txt())
        return
    }
    if srv_route(req.path, "/health") {
        res = srv_ok("{\"status\":\"up\"}")
        return
    }
    // self-serve tenant signup: a peage wallet is the only credential
    if req.method == "POST" && (srv_route(req.path, "/tenants")) {
        w := header(req, "x-peage-wallet")
        if has_prefix(w, "pw_") == false {
            res = srv_err("400 Bad Request", "input", "send X-Peage-Wallet: pw_... (mint one: POST " + tn_peage_url() + "/v1/wallets — see /llms.txt of peage)")
            return
        }
        tid, ttok := tn_create(w, srv_body_str(req, "name"))
        res = srv_ok("{\"tenant\":\"" + tid + "\",\"token\":\"" + ttok + "\",\"pricing\":{\"storage_cents_per_gb_month\":" + str(tn_price()) + ",\"free_bytes\":" + str(tn_free_bytes()) + ",\"pay_rail\":\"peage\"},\"how\":\"use Authorization: Bearer " + ttok + " on /put /get /find /count /agg /index /stats /usage — your data is isolated and metered by disk bytes\"}")
        return
    }
    role, tid := srv_role(req)
    if len(role) == 0 {
        res = srv_err("401 Unauthorized", "auth", "missing or wrong bearer token (tenants self-serve at POST /tenants with X-Peage-Wallet)")
        return
    }
    if role == "tenant" {
        if tn_rl_check(tid) == 1 {
            res = srv_err("429 Too Many Requests", "rate-limited", "fair-use cap: " + str(tn_rate_limit()) + " requests/min per tenant; retry_after_seconds=" + str(tn_rl_retry_after(tid)) + " (throttling is recorded and visible in GET /usage)")
            return
        }
    }
    if g_srv_follow == 0 { tn_sweep() }
    // tenants get a two-level namespace: db (?db=, default "default") / collection
    root := g_srv_db
    // A TENANT's data lives under its own root, and resolving it MUST happen
    // here. The account routes below take `root` BY VALUE, so doing it there
    // assigned a copy that was discarded on return, and every tenant data
    // request silently opened the ADMIN root — which reached production as
    // "docs": 0 on a collection holding 1123 documents.
    if role == "tenant" {
        dbname := query(req, "db")
        if len(dbname) == 0 { dbname = srv_body_str(req, "db") }
        if len(dbname) == 0 { dbname = "default" }
        if valid_id(dbname) == 0 || contains(dbname, ".") {
            res = srv_err("400 Bad Request", "input", "bad db name")
            return
        }
        root = tn_root(tid) + "/" + dbname
    }
    mres, mhandled := srv_meta_routes(req, role, tid, root)
    if mhandled == 1 {
        res = mres
        return
    }
    if g_srv_follow == 1 && req.method == "POST" && req.path != "/shutdown" {
        res = srv_err("403 Forbidden", "read-only", "this is a follower; write to the primary")
        return
    }
    if req.method == "POST" && (srv_route(req.path, "/shutdown")) && role != "admin" {
        res = srv_err("403 Forbidden", "auth", "admin only")
        return
    }
    if srv_use(req, root) == 0 {
        res = srv_err("400 Bad Request", "input", "bad collection name or open failed")
        return
    }
    if g_srv_follow == 1 { gr_refresh() }
    if req.method == "POST" && (srv_route(req.path, "/put")) {
        doc := srv_body_field(req, "doc")
        if valid_doc(doc) == 0 {
            res = srv_err("400 Bad Request", "input", "body must be {\"doc\":{...}} with minified JSON")
            return
        }
        id := srv_body_str(req, "id")
        if len(id) == 0 { id = to_hex(rand_bytes(8)) }
        if valid_id(id) == 0 {
            res = srv_err("400 Bad Request", "input", "invalid id")
            return
        }
        ttl := parse_int(srv_body_field(req, "ttl_seconds"))
        if g_cold == 1 && ttl > 0 {
            res = srv_err("400 Bad Request", "input", "cold collections do not support TTL docs")
            return
        }
        if ttl > 0 {
            if charat(doc, 0) != "{" {
                res = srv_err("400 Bad Request", "input", "ttl_seconds needs an object doc")
                return
            }
            doc = "{\"_expires\":" + str(now_ms() + ttl * 1000) + "," + substr(doc, 1, len(doc))
        }
        gr_put(id, doc)
        if gr_commit() == 0 {
            res = srv_err("500 Internal Server Error", "internal", "wal chunk write failed")
            return
        }
        res = srv_ok("{\"id\":\"" + jesc(id) + "\"}")
        return
    }
    if req.method == "GET" && srv_route(req.path, "/get") {
        id := query(req, "id")
        gr_sweep_expired()
        gdoc := ""
        gfound := 0
        arena {
            gotdoc, gotfound := gr_get(id)
            gdoc = escape(gotdoc)
            gfound = gotfound
        }
        if gfound == 0 {
            res = srv_err("404 Not Found", "not-found", "no document with id " + id)
            return
        }
        res = srv_ok("{\"id\":\"" + jesc(id) + "\",\"doc\":" + gdoc + "}")
        return
    }
    if req.method == "POST" && (srv_route(req.path, "/del")) {
        id := srv_body_str(req, "id")
        if gr_del(id) == 0 {
            res = srv_err("404 Not Found", "not-found", "no document with id " + id)
            return
        }
        if gr_commit() == 0 {
            res = srv_err("500 Internal Server Error", "internal", "wal chunk write failed")
            return
        }
        res = srv_ok("{\"id\":\"" + jesc(id) + "\",\"deleted\":true}")
        return
    }
    if req.method == "GET" && srv_route(req.path, "/find") {
        limit := parse_int(query(req, "limit"))
        if limit == 0 { limit = 100 }
        wh := query(req, "where")
        q_warm(wh)
        // ?fields=a,b returns only those fields (id is always included). Set
        // before the query runs, because projection happens at emit time.
        proj_set(query(req, "fields"))
        // the query reads pages and builds strings that die with the response;
        // only the body escapes, so the loop's arena stays flat (machin escape())
        body := ""
        // ?order=<field> (or order=-field) returns the FIRST/LAST n by that
        // field instead of an arbitrary n — the query a dashboard asks
        ofield, odesc := ord_parse(query(req, "order"), query(req, "desc"))
        if len(ofield) > 0 {
            // outside the arena: the projection it may build is stored globally
            ord_warm(ofield)
            ook := 0
            owhy := ""
            arena {
                d, k, w := q_find_page(wh, limit, ofield, odesc, query(req, "after"))
                body = escape(d)
                ook = k
                owhy = escape(w)
            }
            if ook == 0 {
                res = srv_err("400 Bad Request", "input", owhy)
                return
            }
            if q_aborted() == 1 {
                res = srv_err("400 Bad Request", "input", q_budget_msg(srv_where_fields(wh)))
                return
            }
            res = srv_ok(body)
            return
        }
        arena { body = escape(q_find(wh, limit)) }
        if q_aborted() == 1 {
            res = srv_err("400 Bad Request", "input", q_budget_msg(srv_where_fields(wh)))
            return
        }
        res = srv_ok(body)
        return
    }
    bres, bhandled := srv_bulk_route(req)
    if bhandled == 1 {
        res = bres
        return
    }
    if req.method == "GET" && srv_route(req.path, "/watch") {
        since := parse_int(query(req, "since"))
        tmo := parse_int(query(req, "timeout"))
        if tmo < 1 { tmo = 25 }
        if tmo > 55 { tmo = 55 }
        if g_seq > since || since > g_seq {
            res = srv_ok(watch_payload(since))
            return
        }
        if len(g_w_fd) >= 100 {
            res = srv_err("503 Service Unavailable", "capacity", "too many parked watchers")
            return
        }
        mine := 0
        wi := 0
        while wi < len(g_w_tid) {
            if g_w_tid[wi] == tid { mine = mine + 1 }
            wi = wi + 1
        }
        if role == "tenant" && mine >= 5 {
            res = srv_err("429 Too Many Requests", "watch-capacity", "fair-use cap: max 5 concurrent watchers per tenant")
            return
        }
        g_park_tid = tid
        g_park = tmo
        res = srv_ok("")
        return
    }
    rres, rhandled := srv_tail_routes(req)
    if rhandled == 1 {
        res = rres
        return
    }
    if req.method == "POST" && (srv_route(req.path, "/shutdown")) {
        uok2, uerr2 := gr_use(g_srv_db, "_sys")
        if uok2 == 1 { tn_rl_flush()  gr_commit() }
        gr_commit()
        g_shutdown = 1
        res = srv_ok("{\"stopping\":true}")
        return
    }
    res = srv_err("404 Not Found", "not-found", "no such route; see grange guide")
}

// ---- periodic arena reset ----
//
// A long-lived actor retains memory per request (M37: ~8-16 kB), and grange's
// only answer was the RSS watchdog RESTARTING the process — which drops every
// in-flight request and every parked watcher. poche, which embeds this same
// engine, does something gentler: it calls gr_reset() every N requests, after
// the response is written. grange has gr_reset() and never called it.
//
// gr_reset() frees the arena, and what survives that is narrow. Measured:
// string LITERALS, env() values and args() values survive (they are backed by
// memory outside the arena); COMPUTED strings are silently corrupted — a
// concatenated "tok-secret123-end" came back as "1", with no crash. So anything
// re-derived here must come from args()/env() DIRECTLY, never from the parsed
// flag struct, whose internal maps are themselves computed.
func srv_argv_flag(name) (v) {
    v = ""
    a := args()
    i := 0
    while i < len(a) {
        if a[i] == name && i + 1 < len(a) {
            v = a[i + 1]
            return
        }
        i = i + 1
    }
}

// OFF by default, and that is a measurement result rather than caution. The
// reset lowers the SUSTAINED level a lot (measured over 6000 requests on a 20k
// collection: 46->126 MB without, 23->61 MB with) but each reset is followed by
// a reload of whatever the next request touches, and that spike is proportional
// to the collection. Sampled finely on a three-collection database the peak was
// WORSE with resets (86 MB -> 105 MB). Which effect dominates depends on
// collection size and run length, so the operator opts in.
func srv_reset_every() (n) {
    n = parse_int(env("GRANGE_RESET_EVERY"))
}

var g_req_count = 0
var g_reset_ok = 0
var g_resets = 0

// srv_maybe_reset drops the accumulated arena when it is safe to do so:
// nothing staged, no watcher parked (they hold collection names), and only
// between requests — never with a response half-built.
func srv_maybe_reset() {
    every := srv_reset_every()
    if every == 0 { return }
    if g_reset_ok == 0 { return }
    if g_req_count < every { return }
    if g_pend_recs > 0 { return }
    if len(g_w_fd) > 0 { return }
    if g_park > 0 { return }
    if gr_reset() == 0 { return }
    // re-derive from argv/env only: everything else was just freed
    g_srv_db = srv_argv_flag("--db")
    if len(g_srv_db) == 0 { g_srv_db = env("GRANGE_DB") }
    tok := srv_argv_flag("--token")
    if len(tok) == 0 { tok = env("GRANGE_TOKEN") }
    g_srv_token = tok
    tn_load_cache()
    g_req_count = 0
    g_resets = g_resets + 1
    write(2, "{\"event\":\"arena_reset\",\"resets\":" + str(g_resets) + "}\n")
}

func cmd_serve(fs) {
    do_open(fs)
    g_srv_db = need_db(fs)
    if flag_on(fs, "follow") { g_srv_follow = 1 }
    gr_park()
    tn_load_cache()
    g_sweep_last = now_ms()
    port := flag_int_val(fs, "port")
    if port == 0 { port = 4444 }
    g_srv_token = flag_get(fs, "token")
    if len(g_srv_token) == 0 { g_srv_token = env("GRANGE_TOKEN") }
    generated := 0
    if len(g_srv_token) == 0 {
        g_srv_token = to_hex(rand_bytes(16))
        generated = 1
    }
    // A GENERATED token is a computed string: it cannot be re-derived from
    // argv or env after the arena is freed, and trusting the stale pointer
    // would corrupt authentication. Periodic reset is therefore only enabled
    // when the token came from --token or GRANGE_TOKEN.
    g_reset_ok = 1
    if generated == 1 { g_reset_ok = 0 }
    if len(srv_argv_flag("--db")) == 0 && len(env("GRANGE_DB")) == 0 { g_reset_ok = 0 }
    harden(16777216, 30000)
    server := listen(port)
    socket_timeout(server, 250)
    // Announced AFTER the bind, on purpose. This line used to print first, so a
    // port collision logged {"event":"listening"} and then exited 1 — anything
    // reading the log (a supervisor, an agent, a person) was told the server was
    // up by the process that had just failed to start.
    println("{\"event\":\"listening\",\"port\":" + str(port) + ",\"db\":\"" + jesc(flag_get(fs, "db")) + "\",\"coll\":\"" + jesc(flag_get(fs, "coll")) + "\",\"docs\":" + str(gr_count()) + ",\"token\":\"" + g_srv_token + "\"}")
    flush()
    for {
        conn := accept(server)
        if conn >= 0 {
            started := now_ms()
            socket_timeout(conn, 5000)
            raw := read_request(conn)
            if len(raw) == 0 {
                close(conn)
            } else {
                req := parse_request(raw)
                req.remote = peer_addr(conn)
                g_park = 0
                // NOTE: an arena{}-wrapped read path would keep this loop's RSS flat,
                // but gr_use stores request-derived strings into the registry deep in
                // the call chain — ARENA001 v1 is intraprocedural and cannot prove
                // that escape absent, so we do NOT wrap (a passing check here would
                // be vacuous). The RSS watchdog + eviction bound memory instead.
                // Upstream candidate: interprocedural ARENA001 provenance.
                res := srv_handle(req)
                if g_park > 0 {
                    since := parse_int(query(req, "since"))
                    watch_park(conn, since, g_park)
                } else {
                    srv_write_res(conn, res)
                    g_req_count = g_req_count + 1
                    access_log(req, res.status, len(res.body), now_ms() - started)
                    if g_shutdown == 1 {
                        write(2, "{\"event\":\"shutdown\"}\n")
                        exit(0)
                    }
                }
            }
        }
        watch_tick()
        srv_maybe_reset()
        srv_rss_watchdog()
    }
}
