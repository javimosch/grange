// grange landing + llms.txt — the open (unauthed) face of the hosted instance.
// The interface is the docs: /llms.txt is the full contract written for agents,
// / is a one-page human summary in the intrane.fr house style.

func llms_txt() (t) {
    t = "# grange — a document database your agent can pay for\n\n" +
        "grange is an agent-first document DB: one static binary (MFL/machin), crash-safe\n" +
        "WAL, secondary indexes with O(1) count/sum/avg registers, sorted range indexes.\n" +
        "Faster than SQLite on every indexed workload at 100k docs (see the README bench).\n" +
        "OSS: https://github.com/javimosch/grange  ·  This hosted instance: https://grange.intrane.fr\n" +
        "READ REPLICA: https://read.grange.intrane.fr — same tokens, GET routes only (find/count/agg/get/watch/export); point read-heavy agents here, writes go to the primary\n\n" +
        "## Get a namespace (self-serve; a peage wallet is the only credential)\n\n" +
        "1. mint a wallet:  curl -s -X POST https://peage.intrane.fr/v1/wallets -d '{}'    (save the pw_ token; docs: https://peage.intrane.fr/llms.txt)\n" +
        "2. fund it:        curl -s -X POST https://peage.intrane.fr/v1/topup -H 'Authorization: Bearer pw_...' -d '{\"amount_cents\":500}'   -> a Stripe URL your human pays once\n" +
        "3. sign up here:   curl -s -X POST https://grange.intrane.fr/tenants -H 'X-Peage-Wallet: pw_...' -d '{\"name\":\"my agent\"}'\n" +
        "                   -> {\"tenant\":\"t...\",\"token\":\"gt_...\"}   (save the gt_ token — it is your database)\n\n" +
        "## Pricing (pay-as-you-go, no subscription)\n\n" +
        "Storage: " + str(tn_price()) + " cents/GB/month, first " + str(tn_free_bytes() / 1048576) + " MB free. Accrued continuously\n" +
        "(price/30 per GB-day), charged to your wallet via peage when >= 5 cents. Queries and\n" +
        "writes are free under FAIR USE: " + str(tn_rate_limit()) + " requests/min and 5 concurrent watchers per tenant;\n" +
        "beyond that you get 429 {type:rate-limited, retry_after_seconds} — back off and retry.\n" +
        "Throttling is recorded; your GET /usage shows throttled_requests_total.\n\n" +
        "## The API (Authorization: Bearer gt_... on every call; ?coll= picks a collection, default 'default')\n\n" +
        "PUT     curl -s -X POST $G/put -H \"$A\" -d '{\"coll\":\"leads\",\"id\":\"l1\",\"doc\":{\"co\":\"acme\",\"score\":9}}'   # id optional (auto)\n" +
        "GET     curl -s \"$G/get?coll=leads&id=l1\" -H \"$A\"\n" +
        "DEL     curl -s -X POST $G/del -H \"$A\" -d '{\"coll\":\"leads\",\"id\":\"l1\"}'\n" +
        "FIND    curl -s \"$G/find?coll=leads&where=score%3E%3D5&limit=50\" -H \"$A\"      # where: f=v,f2>v2 (AND; = > < >= <= ~=contains; f=a|b = ANY of; dotted paths reach nested)\n" +
        "ORDER   curl -s \"$G/find?coll=events&order=ts&desc=1&limit=5\" -H \"$A\"          # THE LATEST N. Needs a range index on the field (INDEX with kind:\"range\"); without an order, a limit returns an ARBITRARY subset. Ties break by id, so the order is total.\n" +
        "PAGE    curl -s \"$G/find?coll=events&order=ts&desc=1&limit=5&after=<next>\" -H \"$A\"   # KEYSET paging: the response carries next; pass it back. Every page costs the same, and rows added/removed elsewhere cannot make one repeat or be skipped. next is omitted on a short page = stop. (A row MODIFIED between pages moves in the order and can be seen twice or missed.)\n" +
        "COUNT   curl -s \"$G/count?coll=leads&where=co%3Dacme\" -H \"$A\"                 # O(1) if the field is indexed\n" +
        "INDEX   curl -s -X POST $G/index -H \"$A\" -d '{\"coll\":\"leads\",\"field\":\"co\",\"sums\":\"score\"}'   # kind:\"range\" for > < >= <=\n" +
        "AGG     curl -s \"$G/agg?coll=leads&group-by=co&sum=score\" -H \"$A\"             # count/sum/avg O(1) via registers; minmax= scans\n" +
        "BULK    curl -s -X POST \"$G/bulk?coll=leads\" -H \"$A\" --data-binary @ops.ndjson   # one line per op: '{...}' put auto-id · 'id<TAB>{...}' put · '-<TAB>id' del; ONE commit, all-or-nothing; 263k docs/s measured; on a COLD collection a large batch is written straight to its own run, so ingest never stages through memory\n" +
        "COLLS   curl -s $G/collections -H \"$A\"\n" +
        "DBS     curl -s $G/dbs -H \"$A\"                                              # tenants have MULTIPLE databases: pass db= on any call (default 'default')\n" +
        "STATS   curl -s \"$G/stats?coll=leads\" -H \"$A\"\n" +
        "COMPACT curl -s -X POST $G/compact -H \"$A\" -d '{\"coll\":\"leads\"}'             # fold WAL chunks; run when stats.chunks_replayed grows\n" +
        "COLD    curl -s -X POST \"$G/cold?coll=archive\" -H \"$A\"                          # DISK-RESIDENT mode: data lives in page files, not RAM; point gets read one page; scans stream; SECONDARY INDEXES supported (index --field, 15x faster selective lookups); no TTL on cold; irreversible per collection\n" +
        "WATCH   curl -s \"$G/watch?coll=jobs&since=0&timeout=25\" -H \"$A\"       # LONG-POLL: blocks until the collection changes past since -> {seq,changes:[{seq,op,id}]}; poll again with the returned seq\n" +
        "EXPORT  curl -s \"$G/export?coll=leads&format=lines\" -H \"$A\"              # NDJSON 'id<TAB>doc' lines — pipe straight into /bulk of another grange\n" +
        "VERIFY  curl -s \"$G/verify?coll=leads\" -H \"$A\"                            # integrity check: every file's checksum + record stream, cold manifests vs their pages, declared indexes present and agreeing with the data -> {intact,files_checked,issues[]}\n" +
        "USAGE   curl -s $G/usage -H \"$A\"\n" +
        "HEALTH  curl -s $G/health                                                      # open, no auth\n\n" +
        "Docs are single-line minified JSON. Errors: {\"ok\":false,\"error\":{type,message}} with proper HTTP codes.\n\n" +
        "## Every answer tells you what it cost\n\n" +
        "Query responses carry the plan and its cost: {\"mode\":\"cold-index-multi\",\"scanned\":0,\"pages\":30,...}.\n" +
        "mode starting with `scan` means a missing index, not a slow database — declare one and it becomes\n" +
        "`indexed`/`range`/`cold-index`. Measured on 200k docs: an indexed lookup reads 2 pages where the\n" +
        "same question as a scan reads 256 and examines 50,000 documents. A query that would scan too far is\n" +
        "refused with an error naming the field to index, rather than holding the server for everyone.\n\n" +
        "## Client SDKs (same surface everywhere: db(...).coll(...) scoping + put/get/find/count/agg/index/put_many)\n\n" +
        "Python  pip install grange-db\n" +
        "        from grange_db import Grange\n" +
        "        leads = Grange(url, token).db('crm').coll('leads')\n" +
        "        leads.put({'co':'acme'}); leads.count('co=acme'); leads.put_many([{...},...])\n\n" +
        "Node    npm install grange-db     (>=18, zero deps)\n" +
        "        const { Grange } = require('grange-db')\n" +
        "        const leads = new Grange({url, token}).db('crm').coll('leads')\n" +
        "        await leads.put({co:'acme'}); await leads.count('co=acme'); await leads.putMany([...])\n\n" +
        "Go      go get github.com/javimosch/grange/sdk/go\n" +
        "        leads := grange.New(url, token).DB(\"crm\").Coll(\"leads\")\n" +
        "        id, _ := leads.Put(\"\", map[string]any{\"co\":\"acme\"}); n, _ := leads.Count(\"co=acme\")\n\n" +
        "machin  compose sdk/machin/grange_client.src (https://github.com/javimosch/grange)\n" +
        "        g := grange_client(url, token)  g = grange_use(g, \"crm\", \"leads\")\n" +
        "        id, ok := grange_put(g, \"\", doc)  n := grange_count(g, \"co=acme\")\n\n" +
        "Durability: every write request is one immutable checksummed WAL chunk, FSYNCED before the write is\n" +
        "acknowledged — the chunk's content, then the directory entry that makes it exist. So an acknowledged\n" +
        "write survives a power cut, not merely a process crash. (Not provable from here: that the underlying\n" +
        "DEVICE honours fsync.) A read on the replica after an acknowledged write sees that write.\n" +
        "Your data is exportable at any time and REPLICABLE: `grange follow --from https://grange.intrane.fr --rtoken gt_... --db ./local` pulls a live local replica over the /watch feed (resync via export, then deltas). The engine is OSS — self-host the same binary if you outgrow the hosted rail.\n"
}

func landing_html() (h) {
    h = "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>grange — a document database your agent can pay for</title>\n<meta name=\"description\" content=\"Agent-first document DB: one static binary, crash-safe, faster than SQLite on indexed workloads. Hosted pay-as-you-go at 0.15EUR/GB/month via peage.\">\n<meta name=\"theme-color\" content=\"#f5efe1\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700;9..144,900&family=Public+Sans:wght@400;500;600;700&family=Sometype+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n:root{--hay:#f5efe1;--hay-2:#ece3cf;--card:#fffcf4;--forest:#1b4332;--barn:#2d6a4f;--leaf:#40916c;--sprout:#52b788;--gold:#e9b949;--gold-2:#c9971f;--soil:#2a241b;--ink:#1d2a22;--ink-2:#4a5a50;--muted:#7d887f;--line:rgba(27,67,50,.14);--line-2:rgba(27,67,50,.26);\n  --serif:'Fraunces',Georgia,serif;--sans:'Public Sans',system-ui,sans-serif;--mono:'Sometype Mono',ui-monospace,Menlo,monospace;--ease:cubic-bezier(.32,.72,0,1)}\n*{box-sizing:border-box}\nhtml{background:var(--hay);scroll-behavior:smooth}\nbody{margin:0;background:var(--hay);color:var(--ink);font-family:var(--sans);font-size:16.5px;line-height:1.65;-webkit-font-smoothing:antialiased;overflow-x:hidden}\na{color:var(--barn);text-underline-offset:3px}\ncode,pre{font-family:var(--mono)}\n.wrap{max-width:1120px;margin:0 auto;padding:0 28px}\n\nnav.top{border-bottom:1px solid var(--line)}\nnav.top .wrap{display:flex;align-items:center;justify-content:space-between;height:70px}\n.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--forest);font-family:var(--serif);font-weight:900;font-size:26px;letter-spacing:-.01em}\n.brand img{width:34px;height:34px}\n.links{display:flex;gap:6px;font-size:14.5px}\n.links a{text-decoration:none;color:var(--ink-2);padding:7px 12px;border-radius:999px;transition:background .3s var(--ease)}\n.links a:hover{background:var(--hay-2);color:var(--forest)}\n\n.hero{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;padding:72px 0 88px}\n.hero>*,.subscribe>*,.grid>*{min-width:0}\n.tags{display:flex;flex-wrap:wrap;gap:8px}\n.tag{font-family:var(--mono);font-size:12px;padding:4px 11px;border-radius:999px;background:var(--card);border:1px solid var(--line);color:var(--ink-2)}\n.tag:first-child{background:var(--forest);color:var(--hay);border-color:var(--forest)}\nh1{font-family:var(--serif);font-weight:900;font-size:clamp(38px,4.2vw,58px);line-height:1.02;letter-spacing:-.025em;margin:24px 0 20px;color:var(--forest)}\nh1 em{font-style:italic;font-weight:700;color:var(--leaf)}\n.sub{font-size:19px;color:var(--ink-2);margin:0 0 10px;max-width:30em}\n.warn{font-family:var(--serif);font-style:italic;color:var(--gold-2);margin:0 0 18px}\n.intro{color:var(--ink-2);max-width:34em;margin:0}\n.cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}\n.btn{display:inline-flex;align-items:center;gap:10px;text-decoration:none;font-weight:700;font-size:15px;padding:13px 20px;border-radius:999px;transition:transform .45s var(--ease),background .3s,box-shadow .3s}\n.btn:active{transform:scale(.97)}\n.btn-g{background:var(--forest);color:var(--hay);box-shadow:0 12px 26px -14px rgba(27,67,50,.9)}\n.btn-g:hover{background:var(--barn);transform:translateY(-1px)}\n.btn-l{color:var(--forest);box-shadow:inset 0 0 0 1.5px var(--line-2);background:var(--card)}\n.btn-l:hover{box-shadow:inset 0 0 0 1.5px var(--forest)}\n\n/* bench race */\n.race{background:var(--card);border:1px solid var(--line-2);border-radius:22px;padding:26px 26px 22px;box-shadow:0 40px 80px -50px rgba(27,67,50,.6);position:relative}\n.race h3{font-family:var(--serif);font-weight:700;font-size:22px;margin:0 0 4px;color:var(--forest)}\n.race .note{font-size:13px;color:var(--muted);margin:0 0 18px}\n.lane{margin:0 0 16px}\n.lane .lbl{display:flex;justify-content:space-between;font-size:13.5px;font-weight:600;color:var(--ink-2);margin-bottom:6px}\n.bars{display:grid;gap:6px}\n.bar{display:grid;grid-template-columns:62px 1fr auto;align-items:center;gap:10px;font-family:var(--mono);font-size:12px}\n.bar .who{color:var(--muted)}\n.track{display:block;height:12px;border-radius:6px;background:var(--hay-2);overflow:hidden}\n.fill{display:block;height:100%;border-radius:6px;width:0;transition:width 1.4s var(--ease)}\n.bar.g .fill{background:linear-gradient(90deg,var(--barn),var(--sprout))}\n.bar.s .fill{background:#b9ae98}\n.bar.g .t{color:var(--forest);font-weight:600}\n.bar .t{min-width:78px;text-align:right}\n.race .foot{display:flex;justify-content:space-between;align-items:center;border-top:1px dashed var(--line-2);padding-top:12px;margin-top:6px;font-family:var(--mono);font-size:11.5px;color:var(--muted)}\n.race .foot b{color:var(--gold-2)}\n.badge{position:absolute;right:18px;top:-14px;background:var(--gold);color:var(--soil);font-family:var(--mono);font-size:11.5px;font-weight:500;padding:6px 11px;border-radius:999px;transform:rotate(3deg);box-shadow:0 10px 20px -10px rgba(201,151,31,.8)}\n\n/* sections */\nsection{padding:92px 0 0}\n.kick{font-family:var(--mono);font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--gold-2);margin:0 0 12px;display:flex;align-items:center;gap:10px}\n.kick::before{content:\"\";width:22px;height:2px;background:var(--gold)}\nh2{font-family:var(--serif);font-weight:900;font-size:clamp(30px,3.6vw,46px);line-height:1.06;letter-spacing:-.02em;margin:0 0 20px;color:var(--forest);max-width:18em}\nh2 em{font-style:italic;font-weight:700;color:var(--leaf)}\n.p{color:var(--ink-2);max-width:48em}\n.p strong{color:var(--ink)}\n.p code,.card code,td code{font-size:13.5px;background:var(--hay-2);padding:1px 6px;border-radius:5px;color:var(--forest)}\npre{background:var(--soil);color:#efe6d2;border-radius:16px;padding:22px 24px;font-size:13px;line-height:1.8;overflow-x:auto;margin:16px 0 18px;box-shadow:0 30px 60px -44px rgba(42,36,27,.8)}\npre .cm{color:#a8997b}\npre .cmd{color:var(--gold)}\ntable{width:100%;border-collapse:separate;border-spacing:0;background:var(--card);border:1px solid var(--line-2);border-radius:16px;overflow:hidden;font-size:15px;margin-top:10px}\nth,td{padding:14px 18px;text-align:left;border-bottom:1px solid var(--line)}\ntr:last-child td{border-bottom:0}\nth{font-family:var(--mono);font-weight:500;font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);background:var(--hay-2)}\ntd:nth-child(2){background:rgba(82,183,136,.08)}\ntd strong{color:var(--forest)}\ntd:nth-child(3){color:var(--muted)}\n.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}\n.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:22px 20px 24px;transition:transform .5s var(--ease),border-color .4s}\n.card:hover{transform:translateY(-2px);border-color:var(--line-2)}\n.card h3{font-family:var(--serif);font-weight:700;font-size:19px;color:var(--forest);margin:0 0 8px;line-height:1.2}\n.card p{margin:0;font-size:14.5px;color:var(--ink-2)}\n.card strong{color:var(--forest)}\n.dog{display:grid;grid-template-columns:1fr 1fr;gap:20px}\n.dog>div{min-width:0;background:var(--card);border:1px solid var(--line);border-radius:20px;padding:28px 26px}\n.dog h3{font-family:var(--serif);font-weight:700;font-size:23px;color:var(--forest);margin:0 0 10px}\n.dog p{color:var(--ink-2);font-size:15px}\n.dog pre{font-size:12px}\n.subscribe{margin-top:92px;background:var(--forest);color:#dbe8df;border-radius:26px;padding:44px 40px;display:grid;grid-template-columns:1.1fr .9fr;gap:30px;align-items:center}\n.subscribe h2{color:var(--hay);margin-bottom:12px}\n.subscribe p{margin:0;color:#b9cfc1}\n.subscribe strong{color:var(--gold)}\n.sub-form{display:flex;gap:8px;background:var(--hay);border-radius:999px;padding:6px}\n.sub-form input{flex:1;min-width:0;border:0;background:transparent;padding:10px 14px;font:inherit;color:var(--ink);outline:none}\n.sub-form button{border:0;background:var(--gold);color:var(--soil);font:inherit;font-weight:700;padding:10px 20px;border-radius:999px;cursor:pointer;transition:background .3s}\n.sub-form button:hover{background:#f2c95e}\n.sub-form button:disabled{opacity:.6;cursor:wait}\n#sub-msg{font-size:.9rem;color:#b9cfc1;margin:10px 0 0 10px;min-height:1.4em}\nfooter{margin-top:90px;border-top:1px solid var(--line);padding:28px 0 44px;font-size:14px;color:var(--muted)}\n\n.rv{opacity:0;transform:translateY(18px);transition:opacity .8s var(--ease),transform .8s var(--ease)}\n.rv.in{opacity:1;transform:none}\n@media (prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;transition:none}.fill{transition:none}}\n@media (max-width:980px){.hero,.dog,.subscribe{grid-template-columns:1fr}.grid{grid-template-columns:1fr 1fr}.hero{padding:48px 0 64px;gap:44px}}\n@media (max-width:560px){.wrap{padding:0 16px}.grid{grid-template-columns:1fr}.subscribe{padding:32px 22px}table{font-size:13.5px}th,td{padding:11px 12px}.race{padding:22px 18px 18px}}\n</style>\n<script defer src=\"https://vigie.intrane.fr/vigie.js\" data-site=\"grange.intrane.fr\"></script>\n</head>\n<body>\n<nav class=\"top\"><div class=\"wrap\">\n  <a class=\"brand\" href=\"/\"><img src=\"data:image/svg+xml;base64,\" alt=\"grange\">grange</a>\n  <div class=\"links\"><a href=\"https://github.com/javimosch/grange\">github</a><a href=\"/llms.txt\">api</a><a href=\"https://status.dev.intrane.fr/g/grange\">status</a></div>\n</div></nav>\n\n<main class=\"wrap\">\n  <header class=\"hero\">\n    <div>\n      <div class=\"tags rv\"><span class=\"tag\">agent-first</span><span class=\"tag\">crash-safe</span><span class=\"tag\">one static binary</span><span class=\"tag\">pay-as-you-go</span></div>\n      <h1 class=\"rv\">A document database <em>your agent can pay for.</em></h1>\n      <p class=\"sub rv\">Agents don't want a database console — they want JSON in, JSON out, and a bill they can settle themselves.</p>\n      <p class=\"warn rv\">French for \"barn\" — a place where documents live.</p>\n      <p class=\"intro rv\">grange is a document DB written in <a href=\"https://github.com/javimosch/machin\">machin</a>: crash-safe WAL, indexes with O(1) aggregates, range queries. Embed it, run it, or use this hosted instance — signup is one curl with a <a href=\"https://peage.intrane.fr\">peage</a> wallet.</p>\n      <div class=\"cta rv\"><a class=\"btn btn-g\" href=\"#start\">First 5 minutes →</a><a class=\"btn btn-l\" href=\"/llms.txt\">Read the API</a></div>\n    </div>\n\n    <div class=\"race rv\" id=\"race\" aria-label=\"Benchmark: grange vs SQLite\">\n      <span class=\"badge\">make bench</span>\n      <h3>Faster than SQLite where it matters</h3>\n      <p class=\"note\">100k docs · both engines indexed on the same fields · same box · log scale</p>\n      <div class=\"lane\"><div class=\"lbl\"><span>group-by count/sum/avg × 1000</span></div><div class=\"bars\">\n        <div class=\"bar g\"><span class=\"who\">grange</span><span class=\"track\"><span class=\"fill\" data-w=\"3\"></span></span><span class=\"t\">&lt;1 ms</span></div>\n        <div class=\"bar s\"><span class=\"who\">SQLite</span><span class=\"track\"><span class=\"fill\" data-w=\"100\"></span></span><span class=\"t\">49 s</span></div></div></div>\n      <div class=\"lane\"><div class=\"lbl\"><span>indexed count × 1000</span></div><div class=\"bars\">\n        <div class=\"bar g\"><span class=\"who\">grange</span><span class=\"track\"><span class=\"fill\" data-w=\"3\"></span></span><span class=\"t\">&lt;1 ms</span></div>\n        <div class=\"bar s\"><span class=\"who\">SQLite</span><span class=\"track\"><span class=\"fill\" data-w=\"68\"></span></span><span class=\"t\">1.5 s</span></div></div></div>\n      <div class=\"lane\"><div class=\"lbl\"><span>range count × 1000</span></div><div class=\"bars\">\n        <div class=\"bar g\"><span class=\"who\">grange</span><span class=\"track\"><span class=\"fill\" data-w=\"3\"></span></span><span class=\"t\">&lt;1 ms</span></div>\n        <div class=\"bar s\"><span class=\"who\">SQLite</span><span class=\"track\"><span class=\"fill\" data-w=\"51\"></span></span><span class=\"t\">257 ms</span></div></div></div>\n      <div class=\"lane\" style=\"margin-bottom:10px\"><div class=\"lbl\"><span>bulk insert, 2 indexes maintained</span><span style=\"color:var(--muted);font-weight:500\">higher is better</span></div><div class=\"bars\">\n        <div class=\"bar g\"><span class=\"who\">grange</span><span class=\"track\"><span class=\"fill\" data-w=\"100\"></span></span><span class=\"t\">278k docs/s</span></div>\n        <div class=\"bar s\"><span class=\"who\">SQLite</span><span class=\"track\"><span class=\"fill\" data-w=\"9\"></span></span><span class=\"t\">25k rows/s</span></div></div></div>\n      <div class=\"foot\"><span>write-time registers → O(1) aggregates</span><b>bench ships in the repo</b></div>\n    </div>\n  </header>\n\n  <section>\n    <p class=\"kick rv\">Signup is one curl</p>\n    <h2 class=\"rv\">The wallet <em>is</em> the signup.</h2>\n    <div class=\"rv\"><pre><span class=\"cm\"># get an isolated, metered namespace (the wallet IS the signup)</span>\n<span class=\"cmd\">curl</span> -s -X POST https://grange.intrane.fr/tenants -H 'X-Peage-Wallet: pw_...' -d '{\"name\":\"my agent\"}'\n<span class=\"cm\"># -> {\"tenant\":\"t...\",\"token\":\"gt_...\"}</span>\n\n<span class=\"cmd\">curl</span> -s -X POST https://grange.intrane.fr/put -H 'Authorization: Bearer gt_...' \\\n  -d '{\"coll\":\"leads\",\"doc\":{\"co\":\"acme\",\"score\":9}}'\n<span class=\"cmd\">curl</span> -s 'https://grange.intrane.fr/agg?coll=leads&amp;group-by=co&amp;sum=score' -H 'Authorization: Bearer gt_...'</pre></div>\n  </section>\n\n  <section>\n    <p class=\"kick rv\">The numbers</p>\n    <h2 class=\"rv\">Faster than SQLite <em>where it matters.</em></h2>\n    <p class=\"p rv\">100k docs, both engines indexed on the same fields, same box (bench ships in the repo — <code>make bench</code>):</p>\n    <div class=\"rv\"><table><tr><th>workload</th><th>grange</th><th>SQLite</th></tr><tr><td>bulk insert, 2 indexes maintained</td><td><strong>278k docs/s</strong></td><td>25k rows/s</td></tr><tr><td>indexed count &times; 1000</td><td><strong>&lt;1 ms</strong></td><td>1.5 s</td></tr><tr><td>group-by count/sum/avg &times; 1000</td><td><strong>&lt;1 ms</strong> (write-time registers)</td><td>49 s</td></tr><tr><td>range count &times; 1000</td><td><strong>&lt;1 ms</strong></td><td>257 ms (indexed)</td></tr></table></div>\n  </section>\n\n  <section>\n    <p class=\"kick rv\">What's in the barn</p>\n    <div class=\"grid rv\">\n      <div class=\"card\"><h3>Crash-safe by construction</h3><p>Every commit is one immutable, checksummed WAL chunk. <code>kill -9</code> leaves exactly the committed prefix — the repo ships the harness that proves it.</p></div>\n      <div class=\"card\"><h3>Race-free, provably</h3><p>The server is a single actor with zero goroutines; machin's inferred data-race analysis verifies the whole engine on every build. No Send/Sync, no annotations.</p></div>\n      <div class=\"card\"><h3>RBAC</h3><p><code>POST /tokens</code> issues read-only (<code>ro</code>) or read-write (<code>rw</code>) tokens per tenant. Existing tokens default to <code>rw</code>.</p></div>\n      <div class=\"card\"><h3>Concurrent reads</h3><p><code>GRANGE_CONCURRENT_READS=1</code> auto-spawns a read replica on port+1 and proxies GETs to it — real read concurrency without touching the write path.</p></div>\n      <div class=\"card\"><h3>Automated failover</h3><p><code>POST /promote</code> (admin) flips a <code>--follow</code> follower to primary in one request. The data is already local.</p></div>\n      <div class=\"card\"><h3>Memory introspection</h3><p><code>GET /memory</code> reports RSS, limit, arena resets, loaded collections, and watchdog config. <code>GRANGE_RESET_EVERY</code> reclaims the arena between requests.</p></div>\n      <div class=\"card\"><h3>Pay-as-you-go</h3><p>Storage: <strong>&euro;0.15/GB/month</strong>, first 50 MB free. Queries free. Accrued continuously, charged via peage — no subscription, no card on file.</p></div>\n      <div class=\"card\"><h3>No lock-in</h3><p>The engine is MIT OSS. Export with one curl; self-host the same binary when you outgrow the hosted rail.</p></div>\n    </div>\n  </section>\n\n  <section id=\"start\">\n    <p class=\"kick rv\">First 5 minutes</p>\n    <h2 class=\"rv\">Signup to first query <em>in five curls.</em></h2>\n    <p class=\"p rv\">Hosted — signup to first query in 5 curls (get a wallet at <a href=\"https://peage.intrane.fr\">peage.intrane.fr</a>):</p>\n    <div class=\"rv\"><pre><span class=\"cm\"># 1. signup — the wallet IS the credential, no card, no form</span>\n<span class=\"cmd\">curl</span> -s -X POST https://grange.intrane.fr/tenants \\\n  -H 'X-Peage-Wallet: pw_...' -d '{\"name\":\"my agent\"}'\n<span class=\"cm\"># > {\"tenant\":\"t...\",\"token\":\"gt_...\"}</span>\n\n<span class=\"cm\"># 2. put — store JSON documents, auto-id or your own</span>\n<span class=\"cmd\">curl</span> -s -X POST https://grange.intrane.fr/put \\\n  -H 'Authorization: Bearer gt_...' \\\n  -d '{\"coll\":\"leads\",\"doc\":{\"co\":\"acme\",\"score\":9}}'\n<span class=\"cm\"># 3. index — equality for agg O(1), range for ordering</span>\n<span class=\"cmd\">curl</span> -s -X POST https://grange.intrane.fr/index \\\n  -H 'Authorization: Bearer gt_...' \\\n  -d '{\"coll\":\"leads\",\"field\":\"co\",\"sums\":\"score\"}'\n<span class=\"cmd\">curl</span> -s -X POST https://grange.intrane.fr/index \\\n  -H 'Authorization: Bearer gt_...' \\\n  -d '{\"coll\":\"leads\",\"field\":\"score\",\"kind\":\"range\"}'\n<span class=\"cm\"># 4. find — equality, range, ordered, paginated</span>\n<span class=\"cmd\">curl</span> -s 'https://grange.intrane.fr/find?coll=leads&amp;where=score&gt;=5&amp;order=score&amp;desc=true' \\\n  -H 'Authorization: Bearer gt_...'\n<span class=\"cm\"># 5. aggregate — group-by count/sum/avg, O(1) at write time</span>\n<span class=\"cmd\">curl</span> -s 'https://grange.intrane.fr/agg?coll=leads&amp;group-by=co&amp;sum=score' \\\n  -H 'Authorization: Bearer gt_...'</pre></div>\n    <p class=\"p rv\">Self-hosted — same engine, no signup:</p>\n    <div class=\"rv\"><pre><span class=\"cmd\">curl</span> -sSL -o grange https://github.com/javimosch/grange/releases/latest/download/grange-linux-x86_64\n<span class=\"cmd\">chmod</span> +x grange\n<span class=\"cmd\">./grange</span> put   --db ./data --coll leads --doc '{\"co\":\"acme\",\"score\":9}'\n<span class=\"cmd\">./grange</span> index --db ./data --coll leads --field co --sums score\n<span class=\"cmd\">./grange</span> index --db ./data --coll leads --field score --range\n<span class=\"cmd\">./grange</span> find  --db ./data --coll leads --where 'score&gt;=5' --order score --desc\n<span class=\"cmd\">./grange</span> agg   --db ./data --coll leads --group-by co --sum score</pre></div>\n  </section>\n\n  <section>\n    <p class=\"kick rv\">Dogfooding</p>\n    <h2 class=\"rv\">This page <em>runs on grange.</em></h2>\n    <div class=\"dog rv\">\n      <div>\n        <h3>The subscribe form is a paying tenant</h3>\n        <p>The subscribe form below is not a demo — it is a <strong>paying tenant</strong> of this hosted instance. The flow: landing form &rarr; <code>grange-subscribe</code> (a 130-line machin app) &rarr; machin client SDK &rarr; hosted grange. Every subscriber email is a document in the <code>subscribers</code> collection, stored and queried like any customer's data. The count is live:</p>\n        <pre><span class=\"cmd\">curl</span> -s https://subscribe.grange.intrane.fr/count\n<span class=\"cm\"># > {\"ok\":true,\"data\":{\"subscribers\":4}}</span></pre>\n        <p>The subscribe service is a separate process (a grange actor calling its own HTTP API would deadlock), which is also the honest shape of a customer. Source: <a href=\"https://github.com/javimosch/grange/blob/main/apps/subscribe/subscribe.src\">apps/subscribe/subscribe.src</a></p>\n      </div>\n      <div>\n        <h3>vigie-sync — a live analytics mirror</h3>\n        <p><a href=\"https://vigie.intrane.fr\">vigie</a> is a real analytics product. <a href=\"https://github.com/javimosch/grange/blob/main/apps/vigie-sync/sync.src\">vigie-sync</a> mirrors its SQLite database into grange as a <strong>cold collection</strong> — disk-resident, not held in memory. It runs continuously on the hosted instance: a systemd timer syncs every 10 minutes, a daily one re-checks every aggregate against SQLite as the oracle.</p>\n        <pre><span class=\"cm\"># sync new rows from vigie's SQLite (read-only sidecar)</span>\n<span class=\"cmd\">vigie-sync</span> sync --sqlite /opt/vigie/vigie.db --token gt_...\n\n<span class=\"cm\"># compare: every aggregate must match SQLite exactly</span>\n<span class=\"cmd\">vigie-sync</span> compare --sqlite /opt/vigie/vigie.db --token gt_...\n<span class=\"cm\"># > {\"match\":true,\"checks\":14,\"last_24h_query_ms\":3}</span></pre>\n        <p><strong>14/14 checks match</strong> SQLite: total count, per-site counts, per-kind counts, and a 24-hour window. The 24h query — the one every analytics dashboard runs — was a full scan before the cold range index; it now answers in <strong>3 ms</strong> on 604 events. The sync cursor itself lives in grange (one more dogfood). SQLite stays the source of truth, so a live product carries none of the risk of the experiment.</p>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"subscribe rv\">\n    <div>\n      <h2>Get launch + milestone notes</h2>\n      <p>One mail when something ships (new SDKs, replication, pricing changes). Stored — of course — <strong>in grange itself</strong>: this form's backend is a machin app using the machin client SDK against the hosted service, as a paying tenant.</p>\n    </div>\n    <div>\n      <div class=\"sub-form\"><input id=\"sub-email\" type=\"email\" placeholder=\"you@domain\" aria-label=\"email\"><button id=\"sub-btn\">subscribe</button></div>\n      <p id=\"sub-msg\"></p>\n    </div>\n  </div>\n  <script>(function(){var b=document.getElementById('sub-btn'),e=document.getElementById('sub-email'),m=document.getElementById('sub-msg');b.onclick=function(){var v=(e.value||'').trim();if(!v){m.textContent='enter an email';return}b.disabled=true;m.textContent='...';fetch('https://subscribe.grange.intrane.fr/subscribe',{method:'POST',headers:{'content-type':'text/plain'},body:v}).then(function(r){return r.json()}).then(function(d){b.disabled=false;if(d.ok){m.textContent='you are in — subscriber #'+d.data.subscribers}else{m.textContent=d.error.message}}).catch(function(){b.disabled=false;m.textContent='network error — try again'})}})()</script>\n\n  <section>\n    <p class=\"kick rv\">The interface is the docs</p>\n    <div class=\"rv\"><pre><span class=\"cmd\">curl</span> -s https://grange.intrane.fr/llms.txt   <span class=\"cm\"># the full contract, written for agents</span></pre></div>\n  </section>\n\n  <footer>grange is a single static binary written in <a href=\"https://github.com/javimosch/machin\">machin (MFL)</a>. An <a href=\"https://intrane.fr\">intrane.fr</a> experiment. Storage billed via <a href=\"https://peage.intrane.fr\">peage</a>. · <a href=\"https://github.com/javimosch/grange\">source</a> · <a href=\"https://status.dev.intrane.fr/g/grange\">status</a> · Contact: javi@intrane.fr</footer>\n</main>\n<script>\n(function(){\n  var io='IntersectionObserver' in window?new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{rootMargin:'0px 0px -8% 0px'}):null;\n  document.querySelectorAll('.rv').forEach(function(el){io?io.observe(el):el.classList.add('in');});\n  var fills=[].slice.call(document.querySelectorAll('#race .fill'));\n  function go(){fills.forEach(function(f,i){setTimeout(function(){f.style.width=f.getAttribute('data-w')+'%';},200+i*120);});}\n  function reset(){fills.forEach(function(f){f.style.transition='none';f.style.width='0';void f.offsetWidth;f.style.transition='';});}\n  if(matchMedia('(prefers-reduced-motion: reduce)').matches){fills.forEach(function(f){f.style.width=f.getAttribute('data-w')+'%';});return;}\n  go(); setInterval(function(){reset();go();},9000);\n})();\n</script>\n<script src=\"https://chatsnip.intrane.fr/w.js\" data-agent=\"pk_d72f593842d953d3f037d842\" data-color=\"#1b4332\" defer></script>\n</body>\n</html>\n"
}
