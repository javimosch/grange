// grange landing + llms.txt — the open (unauthed) face of the hosted instance.
// The interface is the docs: /llms.txt is the full contract written for agents,
// / is a one-page human summary in the intrane.fr house style.

func llms_txt() (t) {
    t = "# grange — a document database your agent can pay for\n\n" +
        "grange is an agent-first document DB: one static binary (MFL/machin), crash-safe\n" +
        "WAL, secondary indexes with O(1) count/sum/avg registers, sorted range indexes.\n" +
        "Faster than SQLite on every indexed workload at 100k docs (see the README bench).\n" +
        "OSS: https://github.com/javimosch/grange  ·  This hosted instance: https://grange.intrane.fr\n" +
        "READ REPLICA: https://read.grange.intrane.fr — same tokens, GET routes only (find/count/agg/get/watch/export); point read-heavy agents here, writes go to the primary\n\n" +
        "## Get a namespace (self-serve; a peage wallet is the only credential)\n\n" +
        "1. mint a wallet:  curl -s -X POST https://peage.intrane.fr/v1/wallets -d '{}'    (save the pw_ token; docs: https://peage.intrane.fr/llms.txt)\n" +
        "2. fund it:        curl -s -X POST https://peage.intrane.fr/v1/topup -H 'Authorization: Bearer pw_...' -d '{\"amount_cents\":500}'   -> a Stripe URL your human pays once\n" +
        "3. sign up here:   curl -s -X POST https://grange.intrane.fr/tenants -H 'X-Peage-Wallet: pw_...' -d '{\"name\":\"my agent\"}'\n" +
        "                   -> {\"tenant\":\"t...\",\"token\":\"gt_...\"}   (save the gt_ token — it is your database)\n\n" +
        "## Pricing (pay-as-you-go, no subscription)\n\n" +
        "Storage: " + str(tn_price()) + " cents/GB/month, first " + str(tn_free_bytes() / 1048576) + " MB free. Accrued continuously\n" +
        "(price/30 per GB-day), charged to your wallet via peage when >= 5 cents. Queries and\n" +
        "writes are free under FAIR USE: " + str(tn_rate_limit()) + " requests/min and 5 concurrent watchers per tenant;\n" +
        "beyond that you get 429 {type:rate-limited, retry_after_seconds} — back off and retry.\n" +
        "Throttling is recorded; your GET /usage shows throttled_requests_total.\n\n" +
        "## The API (Authorization: Bearer gt_... on every call; ?coll= picks a collection, default 'default')\n\n" +
        "PUT     curl -s -X POST $G/put -H \"$A\" -d '{\"coll\":\"leads\",\"id\":\"l1\",\"doc\":{\"co\":\"acme\",\"score\":9}}'   # id optional (auto)\n" +
        "GET     curl -s \"$G/get?coll=leads&id=l1\" -H \"$A\"\n" +
        "DEL     curl -s -X POST $G/del -H \"$A\" -d '{\"coll\":\"leads\",\"id\":\"l1\"}'\n" +
        "FIND    curl -s \"$G/find?coll=leads&where=score%3E%3D5&limit=50\" -H \"$A\"      # where: f=v,f2>v2 (AND; = > < >= <= ~=contains; f=a|b = ANY of; dotted paths reach nested)\n" +
        "ORDER   curl -s \"$G/find?coll=events&order=ts&desc=1&limit=5\" -H \"$A\"          # THE LATEST N. Needs a range index on the field (INDEX with kind:\"range\"); without an order, a limit returns an ARBITRARY subset. Ties break by id, so the order is total.\n" +
        "PAGE    curl -s \"$G/find?coll=events&order=ts&desc=1&limit=5&after=<next>\" -H \"$A\"   # KEYSET paging: the response carries next; pass it back. Every page costs the same, and rows added/removed elsewhere cannot make one repeat or be skipped. next is omitted on a short page = stop. (A row MODIFIED between pages moves in the order and can be seen twice or missed.)\n" +
        "COUNT   curl -s \"$G/count?coll=leads&where=co%3Dacme\" -H \"$A\"                 # O(1) if the field is indexed\n" +
        "INDEX   curl -s -X POST $G/index -H \"$A\" -d '{\"coll\":\"leads\",\"field\":\"co\",\"sums\":\"score\"}'   # kind:\"range\" for > < >= <=\n" +
        "AGG     curl -s \"$G/agg?coll=leads&group-by=co&sum=score\" -H \"$A\"             # count/sum/avg O(1) via registers; minmax= scans\n" +
        "BULK    curl -s -X POST \"$G/bulk?coll=leads\" -H \"$A\" --data-binary @ops.ndjson   # one line per op: '{...}' put auto-id · 'id<TAB>{...}' put · '-<TAB>id' del; ONE commit, all-or-nothing; 263k docs/s measured; on a COLD collection a large batch is written straight to its own run, so ingest never stages through memory\n" +
        "COLLS   curl -s $G/collections -H \"$A\"\n" +
        "DBS     curl -s $G/dbs -H \"$A\"                                              # tenants have MULTIPLE databases: pass db= on any call (default 'default')\n" +
        "STATS   curl -s \"$G/stats?coll=leads\" -H \"$A\"\n" +
        "COMPACT curl -s -X POST $G/compact -H \"$A\" -d '{\"coll\":\"leads\"}'             # fold WAL chunks; run when stats.chunks_replayed grows\n" +
        "COLD    curl -s -X POST \"$G/cold?coll=archive\" -H \"$A\"                          # DISK-RESIDENT mode: data lives in page files, not RAM; point gets read one page; scans stream; SECONDARY INDEXES supported (index --field, 15x faster selective lookups); no TTL on cold; irreversible per collection\n" +
        "WATCH   curl -s \"$G/watch?coll=jobs&since=0&timeout=25\" -H \"$A\"       # LONG-POLL: blocks until the collection changes past since -> {seq,changes:[{seq,op,id}]}; poll again with the returned seq\n" +
        "EXPORT  curl -s \"$G/export?coll=leads&format=lines\" -H \"$A\"              # NDJSON 'id<TAB>doc' lines — pipe straight into /bulk of another grange\n" +
        "VERIFY  curl -s \"$G/verify?coll=leads\" -H \"$A\"                            # integrity check: every file's checksum + record stream, cold manifests vs their pages, declared indexes present and agreeing with the data -> {intact,files_checked,issues[]}\n" +
        "USAGE   curl -s $G/usage -H \"$A\"\n" +
        "HEALTH  curl -s $G/health                                                      # open, no auth\n\n" +
        "Docs are single-line minified JSON. Errors: {\"ok\":false,\"error\":{type,message}} with proper HTTP codes.\n\n" +
        "## Every answer tells you what it cost\n\n" +
        "Query responses carry the plan and its cost: {\"mode\":\"cold-index-multi\",\"scanned\":0,\"pages\":30,...}.\n" +
        "mode starting with `scan` means a missing index, not a slow database — declare one and it becomes\n" +
        "`indexed`/`range`/`cold-index`. Measured on 200k docs: an indexed lookup reads 2 pages where the\n" +
        "same question as a scan reads 256 and examines 50,000 documents. A query that would scan too far is\n" +
        "refused with an error naming the field to index, rather than holding the server for everyone.\n\n" +
        "## Client SDKs (same surface everywhere: db(...).coll(...) scoping + put/get/find/count/agg/index/put_many)\n\n" +
        "Python  pip install grange-db\n" +
        "        from grange_db import Grange\n" +
        "        leads = Grange(url, token).db('crm').coll('leads')\n" +
        "        leads.put({'co':'acme'}); leads.count('co=acme'); leads.put_many([{...},...])\n\n" +
        "Node    npm install grange-db     (>=18, zero deps)\n" +
        "        const { Grange } = require('grange-db')\n" +
        "        const leads = new Grange({url, token}).db('crm').coll('leads')\n" +
        "        await leads.put({co:'acme'}); await leads.count('co=acme'); await leads.putMany([...])\n\n" +
        "Go      go get github.com/javimosch/grange/sdk/go\n" +
        "        leads := grange.New(url, token).DB(\"crm\").Coll(\"leads\")\n" +
        "        id, _ := leads.Put(\"\", map[string]any{\"co\":\"acme\"}); n, _ := leads.Count(\"co=acme\")\n\n" +
        "machin  compose sdk/machin/grange_client.src (https://github.com/javimosch/grange)\n" +
        "        g := grange_client(url, token)  g = grange_use(g, \"crm\", \"leads\")\n" +
        "        id, ok := grange_put(g, \"\", doc)  n := grange_count(g, \"co=acme\")\n\n" +
        "Durability: every write request is one immutable checksummed WAL chunk, FSYNCED before the write is\n" +
        "acknowledged — the chunk's content, then the directory entry that makes it exist. So an acknowledged\n" +
        "write survives a power cut, not merely a process crash. (Not provable from here: that the underlying\n" +
        "DEVICE honours fsync.) A read on the replica after an acknowledged write sees that write.\n" +
        "Your data is exportable at any time and REPLICABLE: `grange follow --from https://grange.intrane.fr --rtoken gt_... --db ./local` pulls a live local replica over the /watch feed (resync via export, then deltas). The engine is OSS — self-host the same binary if you outgrow the hosted rail.\n"
}

func landing_html() (h) {
    h = "<!DOCTYPE html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">" +
        "<title>grange — a document database your agent can pay for</title>" +
        "<meta name=\"description\" content=\"Agent-first document DB: one static binary, crash-safe, faster than SQLite on indexed workloads. Hosted pay-as-you-go at 0.15EUR/GB/month via peage.\">" +
        "<style>:root{--bg:#0a0a0f;--panel:#111118;--panel2:#16161f;--line:#1e1e2a;--fg:#e8e8f0;--dim:#8888a0;--dimmer:#55556a;--acc:#52b788;--acc2:#2d6a4f;--warn:#e9c46a;--code-bg:#0d0d14;--code-line:#1a1a24;--radius:12px}" +
        "*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',sans-serif;line-height:1.7;-webkit-font-smoothing:antialiased}" +
        "main{max-width:1080px;margin:0 auto;padding:0 2.5rem 4rem}" +
        "nav{display:flex;align-items:center;justify-content:space-between;padding:1.25rem 0;border-bottom:1px solid var(--line);margin-bottom:0}" +
        "nav .brand{display:flex;align-items:center;gap:.5rem;font-weight:700;font-size:1.05rem;color:var(--fg);text-decoration:none;letter-spacing:-.01em}" +
        "nav .brand img{width:24px;height:24px}" +
        "nav .links a{color:var(--dim);text-decoration:none;font-size:.8rem;margin-left:1.5rem;transition:color .2s}" +
        "nav .links a:hover{color:var(--acc)}" +
        ".hero{padding:3.5rem 0 2rem;background:linear-gradient(180deg,rgba(82,183,136,.03) 0%,transparent 100%)}" +
        ".hero-tags{display:flex;gap:.4rem;flex-wrap:wrap;margin-bottom:1.5rem}" +
        ".tag{display:inline-block;border:1px solid var(--line);border-radius:99px;padding:3px 12px;font-size:.72rem;color:var(--dim);background:var(--panel);letter-spacing:.02em}" +
        "h1{font-size:2.6rem;font-weight:800;margin:0 0 .4rem;letter-spacing:-.03em;line-height:1.1}h1 em{color:var(--acc);font-style:normal}" +
        ".sub{color:var(--dim);font-size:1.05rem;margin:.4rem 0 0;max-width:720px;line-height:1.6}" +
        ".warn{color:var(--warn);font-size:.82rem;margin-top:.8rem}" +
        "h2{color:var(--fg);font-size:1.3rem;font-weight:700;margin-top:3.5rem;padding-bottom:.5rem;border-bottom:1px solid var(--line);letter-spacing:-.01em}" +
        "h2::before{content:'// ';color:var(--acc);font-weight:400;font-family:'JetBrains Mono',ui-monospace,monospace}" +
        "p{color:var(--dim);font-size:.92rem}strong{color:var(--fg)}a{color:var(--acc);text-decoration:none}a:hover{text-decoration:underline}" +
        "pre{background:var(--code-bg);border:1px solid var(--code-line);border-radius:var(--radius);padding:1.25rem;overflow-x:auto;font-family:'JetBrains Mono','Fira Code',ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.78rem;line-height:1.65;position:relative}" +
        "pre .cm{color:var(--dimmer)}pre .cmd{color:var(--acc)}pre .str{color:var(--warn)}" +
        "code{font-family:'JetBrains Mono','Fira Code',ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.82em;background:var(--panel);padding:2px 6px;border-radius:4px}pre code{background:none;padding:0;font-size:inherit}" +
        ".grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:.8rem;margin:1.5rem 0}@media(max-width:900px){.grid{grid-template-columns:1fr 1fr}}@media(max-width:640px){.grid{grid-template-columns:1fr}}" +
        ".card{background:var(--panel);border:1px solid var(--line);border-left:3px solid var(--acc);border-radius:var(--radius);padding:1.1rem 1.25rem;transition:border-color .2s,transform .2s}.card:hover{border-color:var(--acc);transform:translateY(-1px)}" +
        ".card h3{margin:0 0 .4rem;color:var(--fg);font-size:.88rem;font-weight:600}.card p{font-size:.8rem;margin:.2rem 0;line-height:1.5}" +
        "table{border-collapse:collapse;font-size:.82rem;width:100%;margin:1rem 0}td,th{border:1px solid var(--line);padding:8px 14px;text-align:left}th{color:var(--fg);background:var(--panel);font-weight:600;font-size:.75rem;text-transform:uppercase;letter-spacing:.05em}td{color:var(--dim)}tr:hover td{background:rgba(82,183,136,.04)}" +
        ".sub-form{display:flex;gap:.5rem;flex-wrap:wrap;margin:1rem 0}.sub-form input{flex:1;min-width:220px;background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:10px 14px;color:var(--fg);font-family:inherit;font-size:.88rem}.sub-form input:focus{outline:0;border-color:var(--acc)}" +
        ".sub-form button{background:var(--acc);color:#0a0a0c;border:0;border-radius:8px;padding:10px 20px;font-family:inherit;font-weight:700;font-size:.88rem;cursor:pointer;transition:opacity .2s}.sub-form button:hover{opacity:.9}.sub-form button:disabled{opacity:.5;cursor:default}" +
        "footer{margin-top:4rem;color:var(--dimmer);font-size:.78rem;padding-top:1.5rem;border-top:1px solid var(--line)}footer a{color:var(--dim)}" +
        "</style><script defer src=\"https://vigie.intrane.fr/vigie.js\" data-site=\"grange.intrane.fr\"></script></head><body><main>" +
        "<nav><a class=\"brand\" href=\"/\"><img src=\"data:image/svg+xml;base64,\" alt=\"grange\">grange</a>" +
        "<div class=\"links\"><a href=\"https://github.com/javimosch/grange\">github</a><a href=\"/llms.txt\">api</a><a href=\"https://status.dev.intrane.fr/g/grange\">status</a></div></nav>" +
        "<div class=\"hero\">" +
        "<div class=\"hero-tags\"><span class=\"tag\">agent-first</span><span class=\"tag\">crash-safe</span><span class=\"tag\">one static binary</span><span class=\"tag\">pay-as-you-go</span></div>" +
        "<h1><em>grange</em> — a document database<br>your agent can pay for</h1>" +
        "<p class=\"sub\">Agents don't want a database console — they want JSON in, JSON out, and a bill they can settle themselves.</p>" +
        "<p class=\"warn\">French for \"barn\" — a place where documents live.</p>" +
        "</div>" +
        "<p>grange is a document DB written in <a href=\"https://github.com/javimosch/machin\">machin</a>: crash-safe WAL, indexes with O(1) aggregates, range queries. Embed it, run it, or use this hosted instance — signup is one curl with a <a href=\"https://peage.intrane.fr\">peage</a> wallet.</p>" +
        "<pre><span class=\"cm\"># get an isolated, metered namespace (the wallet IS the signup)</span>\n<span class=\"cmd\">curl</span> -s -X POST https://grange.intrane.fr/tenants -H 'X-Peage-Wallet: pw_...' -d '{\"name\":\"my agent\"}'\n<span class=\"cm\"># -> {\"tenant\":\"t...\",\"token\":\"gt_...\"}</span>\n\n<span class=\"cmd\">curl</span> -s -X POST https://grange.intrane.fr/put -H 'Authorization: Bearer gt_...' \\\n  -d '{\"coll\":\"leads\",\"doc\":{\"co\":\"acme\",\"score\":9}}'\n<span class=\"cmd\">curl</span> -s 'https://grange.intrane.fr/agg?coll=leads&amp;group-by=co&amp;sum=score' -H 'Authorization: Bearer gt_...'</pre>" +
        "<h2>faster than SQLite where it matters</h2>" +
        "<p>100k docs, both engines indexed on the same fields, same box (bench ships in the repo — <code>make bench</code>):</p>" +
        "<table><tr><th>workload</th><th>grange</th><th>SQLite</th></tr>" +
        "<tr><td>bulk insert, 2 indexes maintained</td><td><strong>278k docs/s</strong></td><td>25k rows/s</td></tr>" +
        "<tr><td>indexed count &times; 1000</td><td><strong>&lt;1 ms</strong></td><td>1.5 s</td></tr>" +
        "<tr><td>group-by count/sum/avg &times; 1000</td><td><strong>&lt;1 ms</strong> (write-time registers)</td><td>49 s</td></tr>" +
        "<tr><td>range count &times; 1000</td><td><strong>&lt;1 ms</strong></td><td>257 ms (indexed)</td></tr></table>" +
        "<div class=\"grid\">" +
        "<div class=\"card\"><h3>Crash-safe by construction</h3><p>Every commit is one immutable, checksummed WAL chunk. <code>kill -9</code> leaves exactly the committed prefix — the repo ships the harness that proves it.</p></div>" +
        "<div class=\"card\"><h3>Race-free, provably</h3><p>The server is a single actor with zero goroutines; machin's inferred data-race analysis verifies the whole engine on every build. No Send/Sync, no annotations.</p></div>" +
        "<div class=\"card\"><h3>RBAC</h3><p><code>POST /tokens</code> issues read-only (<code>ro</code>) or read-write (<code>rw</code>) tokens per tenant. Existing tokens default to <code>rw</code>.</p></div>" +
        "<div class=\"card\"><h3>Concurrent reads</h3><p><code>GRANGE_CONCURRENT_READS=1</code> auto-spawns a read replica on port+1 and proxies GETs to it — real read concurrency without touching the write path.</p></div>" +
        "<div class=\"card\"><h3>Automated failover</h3><p><code>POST /promote</code> (admin) flips a <code>--follow</code> follower to primary in one request. The data is already local.</p></div>" +
        "<div class=\"card\"><h3>Memory introspection</h3><p><code>GET /memory</code> reports RSS, limit, arena resets, loaded collections, and watchdog config. <code>GRANGE_RESET_EVERY</code> reclaims the arena between requests.</p></div>" +
        "<div class=\"card\"><h3>Pay-as-you-go</h3><p>Storage: <strong>&euro;0.15/GB/month</strong>, first 50 MB free. Queries free. Accrued continuously, charged via peage — no subscription, no card on file.</p></div>" +
        "<div class=\"card\"><h3>No lock-in</h3><p>The engine is MIT OSS. Export with one curl; self-host the same binary when you outgrow the hosted rail.</p></div></div>" +
        "<h2>first 5 minutes</h2>" +
        "<p>Hosted — signup to first query in 5 curls (get a wallet at <a href=\"https://peage.intrane.fr\">peage.intrane.fr</a>):</p>" +
        "<pre><span class=\"cm\"># 1. signup — the wallet IS the credential, no card, no form</span>\n<span class=\"cmd\">curl</span> -s -X POST https://grange.intrane.fr/tenants \\\n  -H 'X-Peage-Wallet: pw_...' -d '{\"name\":\"my agent\"}'\n<span class=\"cm\"># > {\"tenant\":\"t...\",\"token\":\"gt_...\"}</span>\n\n<span class=\"cm\"># 2. put — store JSON documents, auto-id or your own</span>\n<span class=\"cmd\">curl</span> -s -X POST https://grange.intrane.fr/put \\\n  -H 'Authorization: Bearer gt_...' \\\n  -d '{\"coll\":\"leads\",\"doc\":{\"co\":\"acme\",\"score\":9}}'\n<span class=\"cm\"># 3. index — equality for agg O(1), range for ordering</span>\n<span class=\"cmd\">curl</span> -s -X POST https://grange.intrane.fr/index \\\n  -H 'Authorization: Bearer gt_...' \\\n  -d '{\"coll\":\"leads\",\"field\":\"co\",\"sums\":\"score\"}'\n<span class=\"cmd\">curl</span> -s -X POST https://grange.intrane.fr/index \\\n  -H 'Authorization: Bearer gt_...' \\\n  -d '{\"coll\":\"leads\",\"field\":\"score\",\"kind\":\"range\"}'\n<span class=\"cm\"># 4. find — equality, range, ordered, paginated</span>\n<span class=\"cmd\">curl</span> -s 'https://grange.intrane.fr/find?coll=leads&amp;where=score&gt;=5&amp;order=score&amp;desc=true' \\\n  -H 'Authorization: Bearer gt_...'\n<span class=\"cm\"># 5. aggregate — group-by count/sum/avg, O(1) at write time</span>\n<span class=\"cmd\">curl</span> -s 'https://grange.intrane.fr/agg?coll=leads&amp;group-by=co&amp;sum=score' \\\n  -H 'Authorization: Bearer gt_...'</pre>" +
        "<p>Self-hosted — same engine, no signup:</p>" +
        "<pre><span class=\"cmd\">curl</span> -sSL -o grange https://github.com/javimosch/grange/releases/latest/download/grange-linux-x86_64\n<span class=\"cmd\">chmod</span> +x grange\n<span class=\"cmd\">./grange</span> put   --db ./data --coll leads --doc '{\"co\":\"acme\",\"score\":9}'\n<span class=\"cmd\">./grange</span> index --db ./data --coll leads --field co --sums score\n<span class=\"cmd\">./grange</span> index --db ./data --coll leads --field score --range\n<span class=\"cmd\">./grange</span> find  --db ./data --coll leads --where 'score&gt;=5' --order score --desc\n<span class=\"cmd\">./grange</span> agg   --db ./data --coll leads --group-by co --sum score</pre>" +
        "<h2>dogfooding: this page runs on grange</h2>" +
        "<p>The subscribe form below is not a demo — it is a <strong>paying tenant</strong> of this hosted instance. The flow: landing form &rarr; <code>grange-subscribe</code> (a 130-line machin app) &rarr; machin client SDK &rarr; hosted grange. Every subscriber email is a document in the <code>subscribers</code> collection, stored and queried like any customer's data. The count is live:</p>" +
        "<pre><span class=\"cmd\">curl</span> -s https://subscribe.grange.intrane.fr/count\n<span class=\"cm\"># > {\"ok\":true,\"data\":{\"subscribers\":4}}</span></pre>" +
        "<p>The subscribe service is a separate process (a grange actor calling its own HTTP API would deadlock), which is also the honest shape of a customer. Source: <a href=\"https://github.com/javimosch/grange/blob/main/apps/subscribe/subscribe.src\">apps/subscribe/subscribe.src</a></p>" +
        "<h2>dogfooding: vigie-sync — a live analytics mirror</h2>" +
        "<p><a href=\"https://vigie.intrane.fr\">vigie</a> is a real analytics product. <a href=\"https://github.com/javimosch/grange/blob/main/apps/vigie-sync/sync.src\">vigie-sync</a> mirrors its SQLite database into grange as a <strong>cold collection</strong> — disk-resident, not held in memory. It runs continuously on dk1: a systemd timer syncs every 10 minutes, a daily one re-checks every aggregate against SQLite as the oracle.</p>" +
        "<pre><span class=\"cm\"># sync new rows from vigie's SQLite (read-only sidecar)</span>\n<span class=\"cmd\">vigie-sync</span> sync --sqlite /opt/vigie/vigie.db --token gt_...\n\n<span class=\"cm\"># compare: every aggregate must match SQLite exactly</span>\n<span class=\"cmd\">vigie-sync</span> compare --sqlite /opt/vigie/vigie.db --token gt_...\n<span class=\"cm\"># > {\"match\":true,\"checks\":14,\"last_24h_query_ms\":3}</span></pre>" +
        "<p><strong>14/14 checks match</strong> SQLite: total count, per-site counts, per-kind counts, and a 24-hour window. The 24h query — the one every analytics dashboard runs — was a full scan before the cold range index; it now answers in <strong>3 ms</strong> on 604 events. The sync cursor itself lives in grange (one more dogfood). SQLite stays the source of truth, so a live product carries none of the risk of the experiment.</p>" +
        "<h2>get launch + milestone notes</h2>" +
        "<p>One mail when something ships (new SDKs, replication, pricing changes). Stored — of course — <strong>in grange itself</strong>: this form's backend is a machin app using the machin client SDK against the hosted service, as a paying tenant.</p>" +
        "<div class=\"sub-form\"><input id=\"sub-email\" type=\"email\" placeholder=\"you@domain\"><button id=\"sub-btn\">subscribe</button></div>" +
        "<p id=\"sub-msg\" style=\"font-size:.82rem;color:var(--dim)\"></p>" +
        "<script>(function(){var b=document.getElementById('sub-btn'),e=document.getElementById('sub-email'),m=document.getElementById('sub-msg');b.onclick=function(){var v=(e.value||'').trim();if(!v){m.textContent='enter an email';return}b.disabled=true;m.textContent='...';fetch('https://subscribe.grange.intrane.fr/subscribe',{method:'POST',headers:{'content-type':'text/plain'},body:v}).then(function(r){return r.json()}).then(function(d){b.disabled=false;if(d.ok){m.textContent='you are in — subscriber #'+d.data.subscribers}else{m.textContent=d.error.message}}).catch(function(){b.disabled=false;m.textContent='network error — try again'})}})()</script>" +
        "<h2>the interface is the docs</h2>" +
        "<pre><span class=\"cmd\">curl</span> -s https://grange.intrane.fr/llms.txt   <span class=\"cm\"># the full contract, written for agents</span></pre>" +
        "<footer>grange is a single static binary written in <a href=\"https://github.com/javimosch/machin\">machin (MFL)</a>. An <a href=\"https://intrane.fr\">intrane.fr</a> experiment. Storage billed via <a href=\"https://peage.intrane.fr\">peage</a>. · <a href=\"https://github.com/javimosch/grange\">source</a> · <a href=\"https://status.dev.intrane.fr/g/grange\">status</a> · Contact: javi@intrane.fr</footer>" +
        "<script src=\"https://chatsnip.intrane.fr/w.js\" data-agent=\"pk_d72f593842d953d3f037d842\" defer></script>" +
        "</main></body></html>"
}
