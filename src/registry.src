// grange registry — multi-collection park/use/evict + live replica apply.

// ---- multi-collection registry (M4) ----
// Maps are reference types, so parking a collection's state and restoring it
// later is O(1) — the single-actor server switches collections per request.

var R_loaded = make(map[string]int)
var R_mem = make(map[string]map[string]string)
var R_gen = make(map[string]int)
var R_next = make(map[string]int)
var R_ifields = make(map[string][]string)
var R_isums = make(map[string]map[string]string)
var R_ikind = make(map[string]map[string]string)
var R_buckets = make(map[string]map[string][]string)
var R_bcount = make(map[string]map[string]int)
var R_breg = make(map[string]map[string]float)
var R_rvals = make(map[string]map[string][]float)
var R_rids = make(map[string]map[string][]string)
var R_rdirty = make(map[string]map[string]int)
var R_ttl = make(map[string]map[string]int)
var R_seq = make(map[string]int)
var R_seqbase = make(map[string]int)
var g_touch = make(map[string]int)
var R_chg = make(map[string][]string)
var R_cold = make(map[string]int)
var R_tomb = make(map[string]map[string]int)
var R_runrid = make(map[string][]int)
var R_runpages = make(map[string][]int)
var R_runcount = make(map[string][]int)
var R_runfields = make(map[string][]string)
var R_cifields = make(map[string][]string)
var R_cikind = make(map[string]map[string]string)
var R_runiparts = make(map[string][]int)

func gr_key(db, coll) (k) {
    k = db + "\t" + coll
}

func gr_park() {
    if len(g_db) == 0 { return }
    k := gr_key(g_db, g_coll)
    R_loaded[k] = 1
    R_mem[k] = g_mem
    R_gen[k] = g_gen
    R_next[k] = g_next_chunk
    R_ifields[k] = g_ifields
    R_isums[k] = g_isums
    R_ikind[k] = g_ikind
    R_buckets[k] = g_buckets
    R_bcount[k] = g_bcount
    R_breg[k] = g_breg
    R_rvals[k] = g_rvals
    R_rids[k] = g_rids
    R_rdirty[k] = g_rdirty
    R_ttl[k] = g_ttl
    R_seq[k] = g_seq
    R_seqbase[k] = g_seq_base
    R_chg[k] = g_chg
    R_cold[k] = g_cold
    R_tomb[k] = g_tomb
    R_runrid[k] = g_run_rid
    R_runpages[k] = g_run_pages
    R_runcount[k] = g_run_count
    R_runfields[k] = g_run_fields
    R_runiparts[k] = g_run_iparts
    R_cifields[k] = g_cifields
    R_cikind[k] = g_cikind
}

// gr_use switches the active collection, loading it from disk the first time.
// Staged-but-uncommitted writes are committed before parking (the server
// commits per request anyway; this keeps the invariant under any caller).
// gr_evict drops the least-recently-used loaded collections beyond
// GRANGE_MAX_LOADED (default 24). Freed map nodes return to the OS at the
// next watchdog restart (arena bytes don't free mid-process) — eviction's
// real job is bounding what reloads after one.
func gr_evict() {
    maxn := parse_int(env("GRANGE_MAX_LOADED"))
    if maxn == 0 { maxn = 24 }
    loaded := keys(R_loaded)
    if len(loaded) <= maxn { return }
    cur := gr_key(g_db, g_coll)
    oldest := ""
    oldms := 0
    i := 0
    while i < len(loaded) {
        k := loaded[i]
        if k != cur && has_suffix(k, "\t_sys") == false {
            if len(oldest) == 0 || g_touch[k] < oldms {
                oldest = k
                oldms = g_touch[k]
            }
        }
        i = i + 1
    }
    if len(oldest) == 0 { return }
    delete(R_loaded, oldest)
    delete(R_mem, oldest)
    delete(R_gen, oldest)
    delete(R_next, oldest)
    delete(R_ifields, oldest)
    delete(R_isums, oldest)
    delete(R_ikind, oldest)
    delete(R_buckets, oldest)
    delete(R_bcount, oldest)
    delete(R_breg, oldest)
    delete(R_rvals, oldest)
    delete(R_rids, oldest)
    delete(R_rdirty, oldest)
    delete(R_ttl, oldest)
    delete(R_seq, oldest)
    delete(R_seqbase, oldest)
    delete(R_chg, oldest)
    delete(R_cold, oldest)
    delete(R_tomb, oldest)
    delete(R_runrid, oldest)
    delete(R_runpages, oldest)
    delete(R_runcount, oldest)
    delete(R_runfields, oldest)
    delete(R_runiparts, oldest)
    delete(R_cifields, oldest)
    delete(R_cikind, oldest)
    delete(g_touch, oldest)
    write(2, "{\"event\":\"evicted\",\"key\":\"" + oldest + "\",\"loaded\":" + str(len(R_loaded)) + "}\n")
}

func gr_use(db, coll) (ok, errmsg) {
    ok = 1
    errmsg = ""
    g_touch[gr_key(db, coll)] = now_ms()
    if g_db == db && g_coll == coll { return }
    if g_pend_recs > 0 { gr_commit() }
    gr_park()
    k := gr_key(db, coll)
    if R_loaded[k] == 1 {
        g_db = db
        g_coll = coll
        g_mem = R_mem[k]
        g_gen = R_gen[k]
        g_next_chunk = R_next[k]
        g_pend = []string{}
        g_pend_recs = 0
        g_ifields = R_ifields[k]
        g_isums = R_isums[k]
        g_ikind = R_ikind[k]
        g_buckets = R_buckets[k]
        g_bcount = R_bcount[k]
        g_breg = R_breg[k]
        g_rvals = R_rvals[k]
        g_rids = R_rids[k]
        g_rdirty = R_rdirty[k]
        g_ttl = R_ttl[k]
        g_seq = R_seq[k]
        g_seq_base = R_seqbase[k]
        g_chg = R_chg[k]
        g_cold = R_cold[k]
        g_tomb = R_tomb[k]
        g_run_rid = R_runrid[k]
        g_run_pages = R_runpages[k]
        g_run_count = R_runcount[k]
        g_run_fields = R_runfields[k]
        g_run_iparts = R_runiparts[k]
        g_cifields = R_cifields[k]
        g_cikind = R_cikind[k]
        g_pend_ops = []string{}
        return
    }
    ok, errmsg = gr_open(db, coll)
    if ok == 1 {
        gr_park()
        gr_evict()
    }
}

// ---- read-replica support (M12) ----

// gr_apply_live applies record lines through the full write path (indexes,
// registers, ttl, change feed) WITHOUT staging to the WAL — for a follower
// ingesting chunks someone else already made durable.
func gr_apply_live(lines) (recs) {
    recs = 0
    i := 0
    n := len(lines)
    while i < n {
        ln := lines[i]
        if has_prefix(ln, "p|") {
            if i + 1 >= n { recs = -1  return }
            id := substr(ln, 2, len(ln))
            if len(g_ifields) > 0 {
                if has(g_mem, id) { ix_remove(id, g_mem[id]) }
                ix_add(id, lines[i+1])
            }
            g_mem[id] = lines[i+1]
            delete(g_tomb, id)
            gr_ttl_note(id, lines[i+1])
            g_seq = g_seq + 1
            g_chg = append(g_chg, "{\"seq\":" + str(g_seq) + ",\"op\":\"put\",\"id\":\"" + id + "\"}")
            i = i + 2
            recs = recs + 1
        } else if has_prefix(ln, "d|") {
            id := substr(ln, 2, len(ln))
            if len(g_ifields) > 0 && has(g_mem, id) { ix_remove(id, g_mem[id]) }
            delete(g_mem, id)
            delete(g_ttl, id)
            // a cold collection hides a run's copy behind a tombstone, so a
            // REPLAYED delete must record one too: without this a follower kept
            // serving a doc the primary had deleted, because deleting from the
            // memtable is a no-op when the doc lives in a page (recovery via
            // gr_apply_lines always did this; the incremental path predates cold)
            if g_cold == 1 { g_tomb[id] = 1 }
            g_seq = g_seq + 1
            g_chg = append(g_chg, "{\"seq\":" + str(g_seq) + ",\"op\":\"del\",\"id\":\"" + id + "\"}")
            i = i + 1
            recs = recs + 1
        } else {
            recs = -1
            return
        }
    }
    if len(g_chg) > 400 {
        nw := []string{}
        i = len(g_chg) - 200
        while i < len(g_chg) { nw = append(nw, g_chg[i])  i = i + 1 }
        g_chg = nw
    }
}

// gr_reset hard-resets grange's in-memory state, commits any pending writes,
// then frees the MFL arena. Use in long-running single-actor servers when the
// current goroutine's arena would otherwise grow forever (machin #523). After
// reset, all collections are reloaded from disk on next gr_use. Safe because
// grange keeps durable data on disk and the registry only caches live maps.
// gr_reset commits pending writes, drops every in-memory cache, and frees the
// arena. It is how an EMBEDDER keeps a long-lived process flat — poche calls it
// every N requests — and grange's own server does not call it at all.
//
// CONTRACT, and it is sharper than it looks: this frees the arena, so it
// invalidates everything the CALLER is still holding too, not just grange's
// internals. A string read out of a query before the reset is garbage after it.
// Call it at a point where nothing is in flight: after the response is written,
// with no parked watchers (they hold collection names) and no staged writes.
func gr_reset() (ok) {
    ok = 0
    if g_pend_recs > 0 {
        if gr_commit() == 0 { return }
    }
    // Drop every live reference to arena-allocated strings/slices. The maps
    // themselves are malloc-backed, but their keys/values are pointers into
    // the soon-to-be-freed arena. Reassigning the variables makes the old
    // maps unreachable and safe to leave to the OS/malloc after arena_reset.
    g_db = ""
    g_coll = ""
    g_mem = make(map[string]string)
    g_gen = 0
    g_next_chunk = 0
    g_pend = []string{}
    g_pend_recs = 0
    g_pend_ops = []string{}
    g_skipped_chunks = 0
    g_replayed_chunks = 0
    g_ttl = make(map[string]int)
    g_seq = 0
    g_seq_base = 0
    g_chg = []string{}
    g_cold = 0
    g_tomb = make(map[string]int)
    g_run_rid = []int{}
    g_run_pages = []int{}
    g_run_count = []int{}
    g_run_live = []int{}
    g_ifields = []string{}
    g_isums = make(map[string]string)
    g_ikind = make(map[string]string)
    g_buckets = make(map[string][]string)
    g_bcount = make(map[string]int)
    g_breg = make(map[string]float)
    g_rvals = make(map[string][]float)
    g_rids = make(map[string][]string)
    g_rdirty = make(map[string]int)
    // The cold count cache holds the db/coll names it was computed for. Those
    // are pointers into the arena this function is about to free, so leaving
    // them would make the next count compare against freed memory — and worse,
    // could return a stale count for a collection that no longer exists.
    // Found by reading how poche uses grange: it calls gr_reset() every N
    // requests, so it would have hit this and grange's own server would not,
    // because grange never calls gr_reset at all.
    g_cc_db = ""
    g_cc_coll = ""
    g_cc_seq = 0 - 1
    g_cc_val = 0
    R_loaded = make(map[string]int)
    R_mem = make(map[string]map[string]string)
    R_gen = make(map[string]int)
    R_next = make(map[string]int)
    R_ifields = make(map[string][]string)
    R_isums = make(map[string]map[string]string)
    R_ikind = make(map[string]map[string]string)
    R_buckets = make(map[string]map[string][]string)
    R_bcount = make(map[string]map[string]int)
    R_breg = make(map[string]map[string]float)
    R_rvals = make(map[string]map[string][]float)
    R_rids = make(map[string]map[string][]string)
    R_rdirty = make(map[string]map[string]int)
    R_ttl = make(map[string]map[string]int)
    R_seq = make(map[string]int)
    R_seqbase = make(map[string]int)
    R_chg = make(map[string][]string)
    R_cold = make(map[string]int)
    R_tomb = make(map[string]map[string]int)
    R_runrid = make(map[string][]int)
    R_runpages = make(map[string][]int)
    R_runcount = make(map[string][]int)
    g_touch = make(map[string]int)
    arena_reset()
    // g_nl is the only COMPUTED global in the engine — bytes("\n"), built at
    // startup and used by gr_next_line to walk every page, chunk and index
    // file. arena_reset() just freed it, so without this every line-walk
    // searches for garbage: pages read as empty, and `verify` reports
    // "malformed page records" on files that are perfectly fine. Counts still
    // looked correct, because those answer from the manifest and never walk a
    // page — which is exactly how this hid.
    //
    // It lives here rather than at the call site so EMBEDDERS get it: poche
    // calls gr_reset() every N requests and walks pages through this same code.
    g_nl = bytes("\n")
    ok = 1
}

// gr_refresh catches up with chunks another PROCESS appended to this
// collection's directory (the immutable WAL doubles as a replication log).
// Same generation: replay only chunks >= g_next_chunk, live. New generation
// (someone compacted): full reopen. Returns records applied (-1 = reopened).
func gr_refresh() (applied) {
    applied = 0
    // A follower's data changes when the primary's files change, and that does
    // NOT go through this process's commit path — so g_seq, which the cold
    // count cache keys on, may not move. Invalidate explicitly: a stale count
    // on a replica would be a silent wrong answer, which is worse than the
    // scan it saves.
    g_cc_seq = 0 - 1
    entries := list_dir(gr_dir())
    // A cold collection keeps its generation in crun-*.cmeta names, not seg-*,
    // and a flush REPLACES the WAL chunks with a new run — which also restarts
    // chunk numbering. A follower that only tracked chunks would therefore go
    // silently stale (it kept answering from a memtable whose chunks no longer
    // exist, and skipped the renumbered ones). Any change to the run set, a new
    // generation, or a collection that has just been converted to cold means
    // reopen instead of replay: for cold that is cheap (manifests + the current
    // chunks), and it is the only correct read of the new layout.
    if g_cold == 0 && len(read_file(gr_dir() + "/cold.flag")) > 0 {
        rdb := g_db
        rcoll := g_coll
        rok, rerrmsg := gr_open(rdb, rcoll)
        applied = -1
        return
    }
    if g_cold == 1 {
        cmaxgen := 0
        cruns := 0
        ci := 0
        while ci < len(entries) {
            ce := entries[ci]
            if has_prefix(ce, "crun-") && has_suffix(ce, ".cmeta") {
                cgv := parse_int(substr(ce, 5, 11))
                if cgv > cmaxgen { cmaxgen = cgv }
                if cgv == g_gen { cruns = cruns + 1 }
            }
            ci = ci + 1
        }
        if cmaxgen != g_gen || cruns != len(g_run_rid) {
            rdb := g_db
            rcoll := g_coll
            rok, rerrmsg := gr_open(rdb, rcoll)
            applied = -1
            return
        }
    }
    maxgen := g_gen
    i := 0
    while i < len(entries) {
        e := entries[i]
        if has_prefix(e, "seg-") && has_suffix(e, ".grg") {
            gv := parse_int(substr(e, 4, len(e)-4))
            if gv > maxgen { maxgen = gv }
        }
        i = i + 1
    }
    if maxgen != g_gen {
        db := g_db
        coll := g_coll
        ok, errmsg := gr_open(db, coll)
        applied = -1
        return
    }
    pre := "wal-" + gr_pad6(g_gen) + "-"
    fresh := []int{}
    i = 0
    while i < len(entries) {
        e := entries[i]
        if has_prefix(e, pre) && has_suffix(e, ".grg") {
            cn := parse_int(substr(e, len(pre), len(e)-4))
            if cn >= g_next_chunk { fresh = append(fresh, cn) }
        }
        i = i + 1
    }
    fresh = gr_sort_ints(fresh)
    i = 0
    while i < len(fresh) {
        lines, nrecs, cok := gr_load_recfile(gr_dir() + "/" + pre + gr_pad6(fresh[i]) + ".grg")
        if cok == 1 {
            n := gr_apply_live(lines)
            if n > 0 { applied = applied + n }
        }
        g_next_chunk = fresh[i] + 1
        i = i + 1
    }
}
