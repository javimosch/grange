// grange engine — M0 storage core.
//
// On-disk layout, one directory per collection:
//   <db>/<coll>/seg-<gen>.grg        immutable compacted snapshot (generation gen)
//   <db>/<coll>/wal-<gen>-<n>.grg    immutable WAL chunk n under generation gen
//
// A .grg record file is text lines:
//   "p|<id>"  followed by one line of minified JSON (the doc)
//   "d|<id>"  a tombstone
//   final line "#|<nrecs>|<sha12>"   trailer: record count + sha256[:12] of body
//
// A file is valid iff its trailer verifies. Files are written exactly once
// (MFL has no append/rename), so a crash can only leave a truncated LAST
// chunk — recovery drops invalid chunks and keeps the committed prefix.
//
// Recovery: pick the highest generation with a valid segment, load it,
// replay that generation's valid chunks in ascending order.
// Compaction: write seg-(gen+1) from memory, then delete older .grg files.

var g_db = ""
var g_coll = ""
var g_mem = make(map[string]string)
var g_gen = 0
var g_next_chunk = 0
var g_pend = []string{}
var g_pend_recs = 0
var g_skipped_chunks = 0
var g_replayed_chunks = 0
var g_ttl = make(map[string]int)
var g_seq = 0
var g_seq_base = 0
var g_chg = []string{}
var g_pend_ops = []string{}

func gr_dir() (p) {
    p = g_db + "/" + g_coll
}

func gr_pad6(n) (s) {
    s = str(n)
    while len(s) < 6 { s = "0" + s }
}

func gr_chk(body) (c) {
    c = substr(sha256(body), 0, 12)
}

// Durability. write_file returns once the data is in the page cache, so before
// M30 a "committed" chunk could still be lost to a power cut or kernel panic —
// the crash harnesses only ever proved PROCESS-crash safety (kill -9), which the
// page cache survives on its own. fsync closes that gap.
//
// Two syncs are needed, and the second is the one people forget: fsync on the
// file makes its CONTENT durable, but creating that file is a modification of
// its DIRECTORY, so a fully-synced file can still vanish after a crash if the
// directory entry never reached the disk. gr_write_recfile syncs content;
// gr_sync_dir is called at the points that define a commit.
//
// GRANGE_FSYNC=0 turns both off for a throughput-over-durability workload (a
// rebuildable mirror, a benchmark). The default is on: a database that loses an
// acknowledged write on power loss is not crash-safe, whatever the README says.
func gr_fsync_on() (yes) {
    yes = 1
    if env("GRANGE_FSYNC") == "0" { yes = 0 }
}

// gr_sync_dir makes recently created/removed directory entries durable. Call it
// after the write that defines a commit — one sync covers every entry created
// in that directory since the last one.
func gr_sync_dir() (ok) {
    ok = 1
    if gr_fsync_on() == 0 { return }
    if fsync(gr_dir()) < 0 { ok = 0 }
}

// gr_write_recfile writes lines + trailer to path. Returns 1 on success.
// The file's content is made durable before returning, so a caller that writes
// pages and then a manifest gets the ordering it depends on: the manifest can
// only become durable after the pages it names already are.
func gr_write_recfile(path, lines, nrecs) (ok) {
    ok = 0
    body := join(lines, "\n")
    full := body + "\n#|" + str(nrecs) + "|" + gr_chk(body) + "\n"
    if len(lines) == 0 { full = "#|0|" + gr_chk("") + "\n" }
    if write_file(path, full) < 0 { return }
    if gr_fsync_on() == 1 {
        if fsync(path) < 0 { return }
    }
    ok = 1
}

// gr_load_recfile reads and verifies a record file.
// Returns (lines-without-trailer, nrecs, ok).
func gr_load_recfile(path) (lines, nrecs, ok) {
    lines = []string{}
    nrecs = 0
    ok = 0
    content := read_file(path)
    if len(content) == 0 { return }
    raw := split(content, "\n")
    m := len(raw)
    if m > 0 && raw[m-1] == "" { m = m - 1 }
    if m < 1 { return }
    trailer := raw[m-1]
    if has_prefix(trailer, "#|") == false { return }
    parts := split(trailer, "|")
    if len(parts) != 3 { return }
    want_recs := parse_int(parts[1])
    i := 0
    while i < m-1 {
        lines = append(lines, raw[i])
        i = i + 1
    }
    // body is content minus "\n<trailer>\n" — substr beats re-joining the lines
    body := ""
    if m > 1 { body = substr(content, 0, len(content) - len(trailer) - 2) }
    if gr_chk(body) != parts[2] { return }
    nrecs = want_recs
    ok = 1
}

// gr_load_recbody reads + verifies a record file and returns its BODY as
// BYTES. Callers walk it with gr_next_line instead of materialising a per-line
// slice: in a long-lived actor every such slice stays in the arena (~70 kB per
// page read), which is fatal for disk-resident collections that read thousands
// of pages per scan or index build. Bytes (not string) because only
// bytes_index takes a start offset — searching a string would mean copying the
// remainder on every line, which is quadratic.
var g_nl = bytes("\n")

func gr_load_recbody(path) (body, ok) {
    body = bytes("")
    ok = 0
    // read as bytes: no string->bytes copy, and sha256_bytes verifies in place
    raw := read_file_bytes(path)
    n := len(raw)
    if n == 0 { return }
    cut := n
    if byte_at(raw, cut - 1) == 10 { cut = cut - 1 }
    tstart := cut - 1
    while tstart >= 0 {
        if byte_at(raw, tstart) == 10 { break }
        tstart = tstart - 1
    }
    trailer := bytes_str(bytes_sub(raw, tstart + 1, cut))
    if has_prefix(trailer, "#|") == false { return }
    parts := split(trailer, "|")
    if len(parts) != 3 { return }
    cand := bytes("")
    if tstart > 0 { cand = bytes_sub(raw, 0, tstart) }
    if substr(to_hex(sha256_bytes(cand)), 0, 12) != parts[2] { return }
    body = cand
    ok = 1
}

// gr_count_lines counts newline-separated records WITHOUT materialising any
// line (pure index arithmetic): sizing a run must not cost a full copy of the
// batch.
func gr_count_lines(body) (n) {
    n = 0
    pos := 0
    total := len(body)
    while pos < total {
        nl := bytes_index(body, g_nl, pos)
        if nl < 0 {
            if total - pos > 0 { n = n + 1 }
            return
        }
        if nl - pos > 0 { n = n + 1 }
        pos = nl + 1
    }
}

// gr_next_line walks a body: (line, next position, more).
func gr_next_line(body, pos) (line, next, more) {
    line = ""
    next = pos
    more = 0
    n := len(body)
    if pos >= n { return }
    nl := bytes_index(body, g_nl, pos)
    if nl < 0 {
        line = bytes_str(bytes_sub(body, pos, n))
        next = n
        more = 1
        return
    }
    line = bytes_str(bytes_sub(body, pos, nl))
    next = nl + 1
    more = 1
}

// gr_apply_lines replays record lines into the memtable. Returns records applied,
// or -1 on a structurally corrupt stream (should not happen once checksum passed).
func gr_apply_lines(lines) (recs) {
    recs = 0
    i := 0
    n := len(lines)
    while i < n {
        ln := lines[i]
        if has_prefix(ln, "p|") {
            if i + 1 >= n { recs = -1  return }
            id := substr(ln, 2, len(ln))
            g_mem[id] = lines[i+1]
            delete(g_tomb, id)
            gr_ttl_note(id, lines[i+1])
            i = i + 2
            recs = recs + 1
        } else if has_prefix(ln, "d|") {
            id := substr(ln, 2, len(ln))
            delete(g_mem, id)
            delete(g_ttl, id)
            if g_cold == 1 { g_tomb[id] = 1 }
            i = i + 1
            recs = recs + 1
        } else {
            recs = -1
            return
        }
    }
}

// gr_sort_ints — ascending insertion sort (chunk/gen lists are small).
func gr_sort_ints(xs) (out) {
    out = []int{}
    n := len(xs)
    i := 0
    while i < n {
        v := xs[i]
        // find insert position in out
        m := len(out)
        pos := m
        j := 0
        while j < m {
            if xs[i] < out[j] { pos = j  break }
            j = j + 1
        }
        // rebuild with v inserted at pos
        nw := []int{}
        j = 0
        while j < m {
            if j == pos { nw = append(nw, v) }
            nw = append(nw, out[j])
            j = j + 1
        }
        if pos == m { nw = append(nw, v) }
        out = nw
        i = i + 1
    }
}

// gr_open opens (or creates) db/coll and recovers state. Returns (ok, errmsg).
func gr_open(db, coll) (ok, errmsg) {
    ok = 0
    errmsg = ""
    g_db = db
    g_coll = coll
    g_mem = make(map[string]string)
    g_ttl = make(map[string]int)
    g_gen = 0
    g_next_chunk = 0
    g_pend = []string{}
    g_pend_recs = 0
    g_pend_ops = []string{}
    // epoch-based seq: a follower holding a seq from before this open (or a
    // brand-new follower at 0) falls below the epoch and gets a resync —
    // history from earlier process lifetimes is not in the ring.
    g_seq_base = now_ms()
    g_seq = g_seq_base
    g_chg = []string{}
    g_skipped_chunks = 0
    g_replayed_chunks = 0
    g_cold = 0
    g_tomb = make(map[string]int)
    g_run_rid = []int{}
    g_run_pages = []int{}
    g_run_count = []int{}
    g_run_fields = []string{}
    g_run_iparts = []int{}
    g_cifields = []string{}
    g_cikind = make(map[string]string)
    mkdir(db)
    mkdir(gr_dir())
    entries := list_dir(gr_dir())
    if len(entries) == 0 {
        // brand-new collection (or unreadable dir; mkdir above covers create)
        ix_load()
        ix_clear()
        g_cold = 0
        g_tomb = make(map[string]int)
        g_run_rid = []int{}
        g_run_pages = []int{}
        ok = 1
        return
    }
    if len(read_file(gr_dir() + "/cold.flag")) > 0 {
        g_cold = 1
        g_tomb = make(map[string]int)
        // cold generations live in cmeta names, not segment files
        maxgen := 0
        i := 0
        while i < len(entries) {
            e := entries[i]
            if has_prefix(e, "crun-") && has_suffix(e, ".cmeta") {
                gv := parse_int(substr(e, 5, 11))
                if gv > maxgen { maxgen = gv }
            }
            i = i + 1
        }
        g_gen = maxgen
        cold_idx_load()
        cold_load_runs()
        pre := "wal-" + gr_pad6(g_gen) + "-"
        chunks := []int{}
        i = 0
        while i < len(entries) {
            e := entries[i]
            if has_prefix(e, pre) && has_suffix(e, ".grg") {
                chunks = append(chunks, parse_int(substr(e, len(pre), len(e)-4)))
            }
            i = i + 1
        }
        chunks = gr_sort_ints(chunks)
        i = 0
        while i < len(chunks) {
            lines, nrecs, cok := gr_load_recfile(gr_dir() + "/" + pre + gr_pad6(chunks[i]) + ".grg")
            if cok == 1 {
                if gr_apply_lines(lines) >= 0 { g_replayed_chunks = g_replayed_chunks + 1 } else { g_skipped_chunks = g_skipped_chunks + 1 }
            } else {
                g_skipped_chunks = g_skipped_chunks + 1
            }
            if chunks[i] >= g_next_chunk { g_next_chunk = chunks[i] + 1 }
            i = i + 1
        }
        ix_load()
        ix_clear()
        ok = 1
        return
    }
    // collect segment generations
    gens := []int{}
    i := 0
    while i < len(entries) {
        e := entries[i]
        if has_prefix(e, "seg-") && has_suffix(e, ".grg") {
            gens = append(gens, parse_int(substr(e, 4, len(e)-4)))
        }
        i = i + 1
    }
    gens = gr_sort_ints(gens)
    // load the highest valid segment
    gi := len(gens) - 1
    while gi >= 0 {
        lines, nrecs, sok := gr_load_recfile(gr_dir() + "/seg-" + gr_pad6(gens[gi]) + ".grg")
        if sok == 1 {
            if gr_apply_lines(lines) >= 0 {
                g_gen = gens[gi]
                break
            }
        }
        g_mem = make(map[string]string)
        gi = gi - 1
    }
    // replay this generation's chunks in ascending order
    pre := "wal-" + gr_pad6(g_gen) + "-"
    chunks := []int{}
    i = 0
    while i < len(entries) {
        e := entries[i]
        if has_prefix(e, pre) && has_suffix(e, ".grg") {
            chunks = append(chunks, parse_int(substr(e, len(pre), len(e)-4)))
        }
        i = i + 1
    }
    chunks = gr_sort_ints(chunks)
    i = 0
    while i < len(chunks) {
        cn := chunks[i]
        lines, nrecs, cok := gr_load_recfile(gr_dir() + "/wal-" + gr_pad6(g_gen) + "-" + gr_pad6(cn) + ".grg")
        applied := -1
        if cok == 1 { applied = gr_apply_lines(lines) }
        if applied >= 0 {
            g_replayed_chunks = g_replayed_chunks + 1
        } else {
            g_skipped_chunks = g_skipped_chunks + 1
        }
        if cn >= g_next_chunk { g_next_chunk = cn + 1 }
        i = i + 1
    }
    ix_load()
    if len(g_ifields) > 0 { ix_rebuild() } else { ix_clear() }
    ok = 1
}

// gr_ttl_note tracks/clears a doc's expiry from its "_expires" field (ms).
func gr_ttl_note(id, doc) {
    if has_prefix(doc, "{\"_expires\":") {
        v, err := json_get(doc, "._expires")
        if len(err) == 0 { g_ttl[id] = parse_int(v)  return }
    }
    delete(g_ttl, id)
}

// gr_sweep_expired hard-deletes every expired doc; returns how many.
func gr_sweep_expired() (n) {
    n = 0
    ids := keys(g_ttl)
    if len(ids) == 0 { return }
    nowms := now_ms()
    i := 0
    while i < len(ids) {
        if g_ttl[ids[i]] <= nowms {
            gr_del(ids[i])
            n = n + 1
        }
        i = i + 1
    }
    if n > 0 { gr_commit() }
}

// gr_put stages a write (visible immediately; durable at gr_commit).
func gr_put(id, doc) {
    if len(g_ifields) > 0 {
        if has(g_mem, id) { ix_remove(id, g_mem[id]) }
        ix_add(id, doc)
    }
    g_mem[id] = doc
    delete(g_tomb, id)
    gr_ttl_note(id, doc)
    g_pend_ops = append(g_pend_ops, "put\t" + id)
    g_pend = append(g_pend, "p|" + id)
    g_pend = append(g_pend, doc)
    g_pend_recs = g_pend_recs + 1
}

// gr_del stages a delete. Returns 1 if the id existed.
func gr_del(id) (existed) {
    existed = 0
    // build the tombstone BEFORE mutating the maps: on machin < 0.109 a
    // keys()-derived id aliases map storage that delete() frees
    tomb := "d|" + id
    if has(g_mem, id) {
        existed = 1
        if len(g_ifields) > 0 { ix_remove(id, g_mem[id]) }
    } else if g_cold == 1 && has(g_tomb, id) == false {
        d, f := cold_get(id)
        if f == 1 { existed = 1 }
    }
    if g_cold == 1 { g_tomb[id] = 1 }
    delete(g_mem, id)
    delete(g_ttl, id)
    g_pend_ops = append(g_pend_ops, "del\t" + id)
    g_pend = append(g_pend, tomb)
    g_pend_recs = g_pend_recs + 1
}

// gr_commit makes staged writes durable as one WAL chunk. Returns 1 on success.
func gr_commit() (ok) {
    ok = 1
    if g_pend_recs == 0 { return }
    path := gr_dir() + "/wal-" + gr_pad6(g_gen) + "-" + gr_pad6(g_next_chunk) + ".grg"
    ok = gr_write_recfile(path, g_pend, g_pend_recs)
    if ok == 1 {
        // this is THE commit point: the chunk's content is already durable, and
        // syncing the directory makes the chunk's existence durable too. After
        // this returns, the commit survives a power cut.
        gr_sync_dir()
        g_next_chunk = g_next_chunk + 1
        if g_cold == 1 && len(keys(g_mem)) + len(keys(g_tomb)) >= cold_threshold() {
            cold_flush()
            if len(g_run_rid) > cold_max_runs() { gr_compact() }
        }
        // change feed: one seq per committed record, ring capped at ~400
        i := 0
        while i < len(g_pend_ops) {
            tabp := index(g_pend_ops[i], "\t")
            g_seq = g_seq + 1
            g_chg = append(g_chg, "{\"seq\":" + str(g_seq) + ",\"op\":\"" + substr(g_pend_ops[i], 0, tabp) + "\",\"id\":\"" + substr(g_pend_ops[i], tabp + 1, len(g_pend_ops[i])) + "\"}")
            i = i + 1
        }
        if len(g_chg) > 400 {
            nw := []string{}
            i = len(g_chg) - 200
            while i < len(g_chg) { nw = append(nw, g_chg[i])  i = i + 1 }
            g_chg = nw
        }
        g_pend = []string{}
        g_pend_recs = 0
        g_pend_ops = []string{}
    }
}

func gr_get(id) (doc, found) {
    doc = ""
    found = 0
    if g_cold == 1 {
        doc, found = cold_get(id)
        return
    }
    if has(g_mem, id) {
        if has(g_ttl, id) && g_ttl[id] <= now_ms() {
            gr_del(id)
            gr_commit()
            return
        }
        doc = g_mem[id]
        found = 1
    }
}

func gr_count() (n) {
    if g_cold == 1 {
        n = cold_count_all()
        return
    }
    n = len(keys(g_mem))
}

// gr_compact writes a fresh segment at gen+1 and removes older files.
// Returns 1 on success.
func gr_compact() (ok) {
    ok = 0
    if gr_commit() == 0 { return }
    if g_cold == 1 {
        ok = cold_compact()
        return
    }
    newgen := g_gen + 1
    ids := keys(g_mem)
    lines := []string{}
    i := 0
    while i < len(ids) {
        lines = append(lines, "p|" + ids[i])
        lines = append(lines, g_mem[ids[i]])
        i = i + 1
    }
    segname := "seg-" + gr_pad6(newgen) + ".grg"
    if gr_write_recfile(gr_dir() + "/" + segname, lines, len(ids)) == 0 { return }
    // verify the new segment reads back before deleting anything
    vlines, vrecs, vok := gr_load_recfile(gr_dir() + "/" + segname)
    if vok == 0 { return }
    if vrecs != len(ids) { return }
    entries := list_dir(gr_dir())
    i = 0
    while i < len(entries) {
        e := entries[i]
        if has_suffix(e, ".grg") && e != segname {
            remove(gr_dir() + "/" + e)
        }
        i = i + 1
    }
    g_gen = newgen
    g_next_chunk = 0
    ok = 1
}
