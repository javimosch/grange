// grange cold index QUERIES — turning a declared index into candidate ids, and
// candidates into answers. Split out of coldindex.src to keep every file under
// the project's 500-line limit; that file now builds indexes, this one reads
// them.
//
// The invariant worth remembering: an index only ever NARROWS what is read.
// Every candidate is re-verified against the data (cold_idx_resolve), so a
// stale or mis-partitioned entry can cost a wasted page read but can never
// leak a wrong answer. The one exception is deliberate: on a stable collection
// (one run, nothing unflushed, no tombstones) each id appears exactly once, so
// a single-clause COUNT is exact from the index alone.

// cold_idx_candidates collects candidate ids for field==token from every run's
// index page plus the memtable. Unverified: the caller re-checks each doc.
func cold_idx_candidates(field, token) (ids) {
    ids = []string{}
    seen := make(map[string]int)
    r := 0
    while r < len(g_run_rid) {
        pcount := g_run_iparts[r]
        if pcount < 1 { pcount = cold_idx_parts() }
        j := cold_hash(token) & (pcount - 1)
        body, ok := gr_load_recbody(gr_dir() + "/" + cold_idx_name(g_run_rid[r], field, j))
        if ok == 1 {
            pos := 0
            while true {
                ln, next, more := gr_next_line(body, pos)
                if more == 0 { break }
                pos = next
                if has_prefix(ln, "p|") {
                    idline, inext, imore := gr_next_line(body, pos)
                    if imore == 0 { break }
                    pos = inext
                    if substr(ln, 2, len(ln)) == token {
                        if has(seen, idline) == false {
                            seen[idline] = 1
                            ids = append(ids, idline)
                        }
                    }
                }
            }
        }
        r = r + 1
    }
    // unflushed writes live only in the memtable
    mids := keys(g_mem)
    i := 0
    while i < len(mids) {
        if ix_field_tok(g_mem[mids[i]], field) == token {
            if has(seen, mids[i]) == false {
                seen[mids[i]] = 1
                ids = append(ids, mids[i])
            }
        }
        i = i + 1
    }
}

// cold_idx_usable finds the first equality clause on a ready cold index.
// Returns (field, token, ok) — token is the raw JSON form actually stored.
func cold_idx_usable(fields, ops, vals) (field, token, ok) {
    field = ""
    token = ""
    ok = 0
    if g_cold == 0 { return }
    i := 0
    while i < len(fields) {
        if ops[i] == "=" && cold_idx_ready(fields[i]) == 1 {
            field = fields[i]
            // stored tokens are raw JSON: a string value carries its quotes
            token = "\"" + vals[i] + "\""
            if len(cold_idx_candidates(field, token)) == 0 { token = vals[i] }
            ok = 1
            return
        }
        i = i + 1
    }
}

// cold_idx_resolve turns candidate ids into verified results with at most ONE
// read per touched page per run (never more reads than a full scan): the
// memtable resolves for free, then each run's pages are grouped and read once.
func cold_idx_resolve(cands, fields, ops, vals, limit, countonly) (items, n) {
    items = []string{}
    n = 0
    pending := []string{}
    i := 0
    while i < len(cands) {
        id := cands[i]
        if has(g_tomb, id) == false {
            if has(g_mem, id) {
                if wh_match(g_mem[id], fields, ops, vals) == 1 {
                    if countonly == 0 { items = append(items, "{\"id\":\"" + jesc(id) + "\",\"doc\":" + proj_doc(g_mem[id]) + "}") }
                    n = n + 1
                    // the memtable branch ignored the limit entirely, so a cold
                    // `find --limit 3` whose candidates were still unflushed
                    // returned 4 or 5 documents where a hot collection returned
                    // 3. Found by the cold-vs-hot differential fuzz once it
                    // started observing a LIMITED find. countonly is excluded:
                    // a count must see every match.
                    if countonly == 0 && limit > 0 && n >= limit { return }
                }
            } else {
                pending = append(pending, id)
            }
        }
        i = i + 1
    }
    r := len(g_run_rid) - 1
    while r >= 0 {
        if len(pending) == 0 { return }
        if countonly == 0 && limit > 0 && n >= limit { return }
        pcount := g_run_pages[r]
        bypage := make(map[int][]string)
        touched := []int{}
        i = 0
        while i < len(pending) {
            k := cold_hash(pending[i]) & (pcount - 1)
            if len(bypage[k]) == 0 { touched = append(touched, k) }
            bypage[k] = append(bypage[k], pending[i])
            i = i + 1
        }
        still := []string{}
        t := 0
        while t < len(touched) {
            // Stop reading once the limit is satisfied. The inner loop already
            // refused to append past the limit, so every page read after this
            // point resolved candidates whose documents were thrown away: a
            // `find --limit 5` over a 133-candidate window read 120 pages to
            // return 5 documents. The result set is unchanged — this only stops
            // paying for it. countonly is excluded: a count must be exact, and
            // limit does not apply to it.
            if countonly == 0 && limit > 0 && n >= limit { return }
            k := touched[t]
            body, rok := gr_load_recbody(gr_dir() + "/" + cold_page_name(g_run_rid[r], k))
            pput := make(map[string]string)
            pdel := make(map[string]int)
            if rok == 1 {
                pos := 0
                while true {
                    ln, next, more := gr_next_line(body, pos)
                    if more == 0 { break }
                    pos = next
                    if has_prefix(ln, "p|") {
                        dline, dnext, dmore := gr_next_line(body, pos)
                        if dmore == 0 { break }
                        pos = dnext
                        pput[substr(ln, 2, len(ln))] = dline
                    } else {
                        pdel[substr(ln, 2, len(ln))] = 1
                    }
                }
            }
            pend := bypage[k]
            i = 0
            while i < len(pend) {
                id := pend[i]
                if has(pput, id) {
                    if wh_match(pput[id], fields, ops, vals) == 1 {
                        if countonly == 0 {
                            if limit > 0 && n >= limit {
                                i = len(pend)
                            } else {
                                items = append(items, "{\"id\":\"" + jesc(id) + "\",\"doc\":" + proj_doc(pput[id]) + "}")
                                n = n + 1
                            }
                        } else {
                            n = n + 1
                        }
                    }
                } else if has(pdel, id) == false {
                    still = append(still, id)
                }
                i = i + 1
            }
            t = t + 1
        }
        pending = still
        r = r - 1
    }
}

// cold_stable: exactly one run, nothing unflushed, no tombstones. In that state
// every id appears exactly ONCE across the index, so an index entry cannot be
// shadowed by a newer run or the memtable — which means a COUNT can be answered
// from the index alone, with zero data-page reads. Any pending write or extra
// run breaks the guarantee and the query falls back to resolving candidates.
func cold_stable() (yes) {
    yes = 0
    if len(g_run_rid) != 1 { return }
    if len(g_mem) > 0 { return }
    if len(g_tomb) > 0 { return }
    yes = 1
}

// cold_idx_count_only counts entries for `token` in the one run's index page.
func cold_idx_count_only(field, token) (n) {
    n = 0
    pcount := g_run_iparts[0]
    if pcount < 1 { pcount = cold_idx_parts() }
    j := cold_hash(token) & (pcount - 1)
    body, ok := gr_load_recbody(gr_dir() + "/" + cold_idx_name(g_run_rid[0], field, j))
    if ok == 0 { n = 0 - 1  return }
    pos := 0
    while true {
        ln, next, more := gr_next_line(body, pos)
        if more == 0 { return }
        pos = next
        if has_prefix(ln, "p|") {
            idl, inext, imore := gr_next_line(body, pos)
            if imore == 0 { return }
            pos = inext
            if substr(ln, 2, len(ln)) == token { n = n + 1 }
        }
    }
}

// cold_intersect keeps only ids present in both sets (the smaller one drives).
func cold_intersect(a, b) (out) {
    out = []string{}
    small := a
    big := b
    if len(b) < len(a) { small = b  big = a }
    inbig := make(map[string]int)
    i := 0
    while i < len(big) {
        inbig[big[i]] = 1
        i = i + 1
    }
    i = 0
    while i < len(small) {
        if has(inbig, small[i]) { out = append(out, small[i]) }
        i = i + 1
    }
}

// cold_all_candidates gathers candidates from EVERY clause an index covers and
// intersects them, so the classic dashboard query (an equality clause AND a time
// window) narrows on both dimensions instead of resolving one index's whole
// bucket. Returns (ids, indexes_used, all_clauses_covered).
func cold_all_candidates(fields, ops, vals) (ids, used, covered) {
    ids = []string{}
    used = 0
    covered = 1
    i := 0
    while i < len(fields) {
        got := 0
        cands := []string{}
        if ops[i] == "=" {
            if cold_idx_ready(fields[i]) == 1 && cold_is_range(fields[i]) == 0 {
                tok := "\"" + vals[i] + "\""
                if len(cold_idx_candidates(fields[i], tok)) == 0 { tok = vals[i] }
                cands = cold_idx_candidates(fields[i], tok)
                got = 1
            } else if cold_is_range(fields[i]) == 1 && cold_idx_ready(fields[i]) == 1 {
                rc, pr := cold_rng_candidates(fields[i], "=", vals[i])
                cands = rc
                got = 1
            }
        } else if ops[i] != "~=" {
            if cold_is_range(fields[i]) == 1 && cold_idx_ready(fields[i]) == 1 {
                rc, pr := cold_rng_candidates(fields[i], ops[i], vals[i])
                cands = rc
                got = 1
            }
        }
        if got == 1 {
            if used == 0 { ids = cands } else { ids = cold_intersect(ids, cands) }
            used = used + 1
        } else {
            covered = 0
        }
        i = i + 1
    }
}

// q_cold_index answers a cold query through an index page when one covers an
// equality clause. Candidates are re-verified against the authoritative doc
// (newer run / memtable / tombstone), so results are exact.
// Returns (items, n, used) — used=0 means the caller must scan.
func q_cold_index(fields, ops, vals, limit, countonly) (items, n, used) {
    items = []string{}
    n = 0
    used = 0
    if g_cold == 0 { return }
    if len(fields) == 0 { return }
    cands, nidx, covered := cold_all_candidates(fields, ops, vals)
    if nidx == 0 { return }
    used = 1
    if nidx > 1 { used = 2 }
    // index-only answer: on a stable collection every id appears exactly once,
    // so if the indexes cover EVERY clause the intersection is already the
    // answer — no data page is read at all
    if countonly == 1 && covered == 1 && cold_stable() == 1 {
        n = len(cands)
        return
    }
    if countonly == 1 {
        arena {
            xi, xn := cold_idx_resolve(cands, fields, ops, vals, 0, 1)
            n = xn
        }
        return
    }
    items, n = cold_idx_resolve(cands, fields, ops, vals, limit, countonly)
}
