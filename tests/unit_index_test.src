// unit: hot indexes (buckets + aggregate registers), range projection,
// numeric/format helpers. Uses a scratch db for the bucket-maintenance cases.

func ui_dir() (d) {
    d = "/tmp/grange-ut-index-" + str(now_ms())
}

func ui_fstr() {
    assert_eq_str(ix_fstr(0.0), "0", "fstr zero")
    assert_eq_str(ix_fstr(7.0), "7", "fstr integral")
    // %g would print 1.66497e+07 here — the register sums must stay exact
    assert_eq_str(ix_fstr(16649667.0), "16649667", "fstr big integral exact")
    assert_eq_str(ix_fstr(499.5), "499.5", "fstr one decimal")
    assert_eq_str(ix_fstr(0.0 - 2.25), "-2.25", "fstr negative")
    assert_eq_str(ix_fstr(0.000001), "0.000001", "fstr 6th decimal kept")
    assert_eq_str(ix_fstr(2.9999999), "3", "fstr rounds up at the 7th decimal")
}

func ui_tokens() {
    assert_eq_str(ix_field_tok("{\"a\":1}", "a"), "1", "token for number")
    assert_eq_str(ix_field_tok("{\"a\":\"x\"}", "a"), "\"x\"", "token keeps quotes for strings")
    assert_eq_str(ix_field_tok("{\"a\":1}", "missing"), "", "absent field = empty token")
    assert_eq_str(ix_fstr(ix_tok_num("42")), "42", "tok_num raw number")
    assert_eq_str(ix_fstr(ix_tok_num("\"42\"")), "42", "tok_num quoted number")
    assert_eq_str(ix_fstr(ix_tok_num("\"abc\"")), "0", "tok_num non-numeric = 0")
}

func ui_buckets_and_registers() {
    db := ui_dir()
    ok, errmsg := gr_open(db, "c")
    gr_put("a", "{\"s\":\"x\",\"v\":5}")
    gr_put("b", "{\"s\":\"x\",\"v\":7}")
    gr_put("c", "{\"s\":\"y\",\"v\":1}")
    gr_commit()
    assert_eq_int(gr_index_add("s", "v", ""), 1, "declare index with sum register")
    assert_eq_int(g_bcount["s\t\"x\""], 2, "bucket count")
    assert_eq_str(ix_fstr(g_breg["s\t\"x\"\tv"]), "12", "register sums both docs")
    assert_eq_int(ix_is_indexed("s"), 1, "field reported indexed")
    assert_eq_int(ix_is_indexed("nope"), 0, "other field not indexed")
    // an overwrite must move the doc between buckets AND fix both registers
    gr_put("a", "{\"s\":\"y\",\"v\":10}")
    assert_eq_int(g_bcount["s\t\"x\""], 1, "old bucket decremented on overwrite")
    assert_eq_int(g_bcount["s\t\"y\""], 2, "new bucket incremented on overwrite")
    assert_eq_str(ix_fstr(g_breg["s\t\"x\"\tv"]), "7", "old register loses the moved value")
    assert_eq_str(ix_fstr(g_breg["s\t\"y\"\tv"]), "11", "new register gains it")
    // a delete must decrement both
    gr_del("c")
    assert_eq_int(g_bcount["s\t\"y\""], 1, "delete decrements bucket")
    assert_eq_str(ix_fstr(g_breg["s\t\"y\"\tv"]), "10", "delete decrements register")
    // an idempotent re-declare must not double-count
    assert_eq_int(gr_index_add("s", "v", ""), 1, "re-declare same field")
    assert_eq_int(len(g_ifields), 1, "no duplicate field declaration")
    assert_eq_int(g_bcount["s\t\"y\""], 1, "rebuild is not additive")
    // declarations survive a reopen and rebuild identically
    gr_commit()
    ok, errmsg = gr_open(db, "c")
    assert_eq_int(len(g_ifields), 1, "declaration persisted")
    assert_eq_str(ix_fstr(g_breg["s\t\"y\"\tv"]), "10", "register rebuilt on open")
    // ix_bucket resolves user input to the stored token form
    assert_eq_str(ix_bucket("s", "y"), "s\t\"y\"", "bucket key for string value")
    gr_put("n1", "{\"k\":42}")
    gr_commit()
    assert_eq_int(gr_index_add("k", "", ""), 1, "index numeric field")
    assert_eq_str(ix_bucket("k", "42"), "k\t42", "bucket key for numeric value")
    assert_eq_str(ix_bucket("k", "nosuch"), "k\t\"nosuch\"", "unknown value falls back to quoted form")
}

func ui_range_projection() {
    db := ui_dir()
    ok, errmsg := gr_open(db, "r")
    i := 0
    while i < 50 {
        gr_put("m" + str(i), "{\"v\":" + str(i) + "}")
        i = i + 1
    }
    gr_commit()
    assert_eq_int(gr_index_add("v", "", "range"), 1, "declare range index")
    rb_ensure("v")
    assert_eq_int(len(g_rvals["v"]), 50, "projection covers every doc")
    // sorted invariant across the whole projection
    sorted := 1
    i = 1
    while i < len(g_rvals["v"]) {
        if g_rvals["v"][i] < g_rvals["v"][i-1] { sorted = 0 }
        i = i + 1
    }
    assert_eq_int(sorted, 1, "projection is ascending")
    // binary-search bounds on every operator, including empty results
    lo, hi := rb_bounds("v", ">=", "45")
    assert_eq_int(hi - lo, 5, ">= bound counts 45..49")
    lo, hi = rb_bounds("v", ">", "45")
    assert_eq_int(hi - lo, 4, "> bound excludes 45")
    lo, hi = rb_bounds("v", "<", "5")
    assert_eq_int(hi - lo, 5, "< bound counts 0..4")
    lo, hi = rb_bounds("v", "<=", "5")
    assert_eq_int(hi - lo, 6, "<= bound includes 5")
    lo, hi = rb_bounds("v", ">=", "1000")
    assert_eq_int(hi - lo, 0, "bound above max is empty")
    lo, hi = rb_bounds("v", "<", "-1")
    assert_eq_int(hi - lo, 0, "bound below min is empty")
    // M32: a WINDOW folds every clause into one span, so it stays two binary
    // searches instead of falling through to a scan
    wf := []string{"v", "v"}
    wo := []string{">=", "<"}
    wv := []string{"10", "20"}
    assert_eq_int(rb_usable(wf, wo), 1, "two clauses on one range field are usable")
    lo, hi = rb_bounds_all(wf, wo, wv)
    assert_eq_int(hi - lo, 10, "window counts 10..19")
    // an empty span, not a negative one, when the clauses exclude each other
    lo, hi = rb_bounds_all(wf, []string{">=", "<"}, []string{"40", "10"})
    assert_eq_int(hi - lo, 0, "contradictory window is empty")
    // three clauses fold too, narrowest wins on each side
    lo, hi = rb_bounds_all([]string{"v", "v", "v"}, []string{">=", ">=", "<"}, []string{"10", "15", "20"})
    assert_eq_int(hi - lo, 5, "widest lower bound and narrowest upper bound win")
    // clauses on DIFFERENT fields must not be folded into one projection
    assert_eq_int(rb_usable([]string{"v", "grp"}, []string{">=", "<"}), 0, "mixed fields are not usable")
    // nor an equality/substring op, which the projection cannot answer
    assert_eq_int(rb_usable([]string{"v", "v"}, []string{">=", "="}), 0, "equality clause is not usable")
    // a write invalidates and the next query rebuilds with the new doc
    gr_put("extra", "{\"v\":999}")
    gr_commit()
    assert_eq_int(g_rdirty["v"], 1, "write marks projection dirty")
    rb_ensure("v")
    assert_eq_int(len(g_rvals["v"]), 51, "rebuild picks up the new doc")
    lo, hi = rb_bounds("v", ">=", "999")
    assert_eq_int(hi - lo, 1, "new doc is findable by range")
}

func ui_msort() {
    // duplicates and reverse order are the merge-sort edge cases
    vals := []float{3.0, 1.0, 2.0, 1.0}
    ids := []string{"c", "a", "b", "a2"}
    sv, si := rb_msort(vals, ids)
    assert_eq_int(len(sv), 4, "msort keeps every element")
    assert_eq_str(ix_fstr(sv[0]), "1", "msort first")
    assert_eq_str(ix_fstr(sv[1]), "1", "msort duplicate kept adjacent")
    assert_eq_str(ix_fstr(sv[3]), "3", "msort last")
    assert_eq_int(len(si), 4, "ids carried alongside values")
    // single element and empty input must not crash
    one_v, one_i := rb_msort([]float{5.0}, []string{"x"})
    assert_eq_str(ix_fstr(one_v[0]), "5", "msort single element")
    zero_v, zero_i := rb_msort([]float{}, []string{})
    assert_eq_int(len(zero_v), 0, "msort empty input")
}


// M33: ordered queries. The projection is already sorted, so ordering is a
// direction plus a limit — these check the contract rather than the mechanism.
func ui_ordered_queries() {
    db := "/tmp/grange-ut-ord-" + str(now_ms())
    ok, errmsg := gr_open(db, "c")
    i := 0
    while i < 12 {
        // two documents share v=5 so the tie-break is exercised
        v := i
        if i == 7 { v = 5 }
        gr_put("k" + str(i), "{\"v\":" + str(v) + ",\"grp\":\"g" + str(i % 2) + "\"}")
        i = i + 1
    }
    gr_commit()

    // ordering needs a range index, and the refusal names the fix
    rdy, why := ord_ready("v")
    assert_eq_int(rdy, 0, "no ordering before the index is declared")
    saw := 0
    if index(why, "--range") > 0 { saw = 1 }
    assert_eq_int(saw, 1, "refusal names the command that fixes it")

    assert_eq_int(gr_index_add("v", "", "range"), 1, "declare range index")
    rdy, why = ord_ready("v")
    assert_eq_int(rdy, 1, "ordering ready once declared")

    // descending returns the HIGHEST values, which is the whole point
    d, dok, dwhy := q_find_ordered("", 3, "v", 1)
    dc, dcerr := json_get(d, ".count")
    assert_eq_str(dc, "3", "desc returns the limit")
    v0, v0err := json_get(d, ".items[0].doc.v")
    v1, v1err := json_get(d, ".items[1].doc.v")
    v2, v2err := json_get(d, ".items[2].doc.v")
    assert_eq_str(v0, "11", "highest first")
    assert_eq_str(v1, "10", "then next highest")
    assert_eq_str(v2, "9", "and the third")

    // ascending returns the lowest
    a, aok, awhy := q_find_ordered("", 2, "v", 0)
    av0, av0err := json_get(a, ".items[0].doc.v")
    assert_eq_str(av0, "0", "asc starts at the lowest")

    // a window bounds the span, and ordering applies WITHIN it
    w, wok, wwhy := q_find_ordered("v>=3,v<6", 2, "v", 1)
    wc, wcerr := json_get(w, ".count")
    assert_eq_str(wc, "2", "window + limit")
    wv0, wv0err := json_get(w, ".items[0].doc.v")
    assert_eq_str(wv0, "5", "highest inside the window, not the collection")

    // ties are a total order: equal values sort by id, so the sequence is
    // reproducible rather than incidental
    t, tok, twhy := q_find_ordered("v>=5,v<6", 10, "v", 0)
    tc, tcerr := json_get(t, ".count")
    assert_eq_str(tc, "2", "both tied documents returned")
    tid0, tid0err := json_get(t, ".items[0].id")
    tid1, tid1err := json_get(t, ".items[1].id")
    assert_eq_str(tid0, "\"k5\"", "tie broken by id, lowest first")
    assert_eq_str(tid1, "\"k7\"", "then the next id")

    // a non-ordering clause still filters
    f, fok, fwhy := q_find_ordered("grp=g0", 3, "v", 1)
    fv0, fv0err := json_get(f, ".items[0].doc.v")
    assert_eq_str(fv0, "10", "highest v among grp=g0 only")
}


// M35: keyset cursors. The end-to-end walk is covered by
// scripts/pagination_test.sh; these pin the pieces it relies on.
func ui_cursors() {
    // round-trip, including a negative value and an id containing punctuation
    c := ord_cursor_make(0.0 - 12.5, "user@example.com")
    v, id, ok := ord_cursor_parse(c)
    assert_eq_int(ok, 1, "cursor parses")
    assert_eq_str(str(v), "-12.5", "value round-trips")
    assert_eq_str(id, "user@example.com", "id round-trips")

    // large integers must not go through %g and lose precision — a timestamp
    // cursor that rounds would resume at the wrong place
    c = ord_cursor_make(1785223773.0, "e728")
    assert_eq_str(c, "1785223773|e728", "a timestamp cursor is not rounded")
    v, id, ok = ord_cursor_parse(c)
    // compare through ix_fstr, not str(): str() is %g and would print
    // 1.78522e+09 for a value that round-tripped perfectly. The cursor never
    // goes through str(), so asserting on str() would test the wrong thing.
    assert_eq_str(ix_fstr(v), "1785223773", "timestamp value round-trips exactly")
    assert_eq_str(id, "e728", "id after a long value")

    // malformed cursors are refused, not guessed at
    v, id, ok = ord_cursor_parse("")
    assert_eq_int(ok, 0, "empty cursor is not a cursor")
    v, id, ok = ord_cursor_parse("12.5")
    assert_eq_int(ok, 0, "value with no id is refused")
    v, id, ok = ord_cursor_parse("12.5|")
    assert_eq_int(ok, 0, "empty id is refused")

    // full-key seek: the position of a key among EQUAL values is what a
    // cursor needs, and what a value-only search cannot give
    db := "/tmp/grange-ut-cur-" + str(now_ms())
    o, e := gr_open(db, "c")
    gr_put("a", "{\"v\":5}")
    gr_put("b", "{\"v\":5}")
    gr_put("c", "{\"v\":5}")
    gr_put("d", "{\"v\":9}")
    gr_commit()
    assert_eq_int(gr_index_add("v", "", "range"), 1, "range index")
    rb_ensure("v")
    // strictly after (5,"b") is "c" at index 2; at-or-after (5,"b") is index 1
    assert_eq_int(rb_seek_key("v", 5.0, "b", 0), 2, "seek strictly past a tied key")
    assert_eq_int(rb_seek_key("v", 5.0, "b", 1), 1, "seek to a tied key")
    assert_eq_int(rb_seek_key("v", 5.0, "zzz", 0), 3, "past every tie at that value")
    assert_eq_int(rb_seek_key("v", 0.0, "a", 0), 0, "before everything")
    assert_eq_int(rb_seek_key("v", 99.0, "a", 0), 4, "after everything")

    // and a short page offers no cursor: there is nothing after it
    d1, ok1, w1 := q_find_page("", 2, "v", 0, "")
    n1, n1err := json_get(d1, ".next")
    assert_eq_int(len(n1err), 0, "a full page offers a cursor")
    d2, ok2, w2 := q_find_page("", 100, "v", 0, "")
    n2, n2err := json_get(d2, ".next")
    shorthasnone := 0
    if len(n2err) > 0 { shorthasnone = 1 }
    assert_eq_int(shorthasnone, 1, "a short page offers none")
}

func main() {
    ui_fstr()
    ui_tokens()
    ui_buckets_and_registers()
    ui_range_projection()
    ui_msort()
    ui_ordered_queries()
    ui_cursors()
    test_summary()
}
