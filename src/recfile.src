// grange record files — the on-disk format, and the durability discipline.
//
// Split out of engine.src to keep every file under the project's 500-line
// limit. Everything here is about ONE concern: a .grg file is lines plus a
// "#|<nrecs>|<sha12>" trailer, it is written exactly once, and it is fsynced
// before anyone is told it exists. The engine above it deals in memtables,
// generations and recovery; this deals in bytes and durability.

func gr_chk(body) (c) {
    c = substr(sha256(body), 0, 12)
}

// Durability. write_file returns once the data is in the page cache, so before
// M30 a "committed" chunk could still be lost to a power cut or kernel panic —
// the crash harnesses only ever proved PROCESS-crash safety (kill -9), which the
// page cache survives on its own. fsync closes that gap.
//
// Two syncs are needed, and the second is the one people forget: fsync on the
// file makes its CONTENT durable, but creating that file is a modification of
// its DIRECTORY, so a fully-synced file can still vanish after a crash if the
// directory entry never reached the disk. gr_write_recfile syncs content;
// gr_sync_dir is called at the points that define a commit.
//
// GRANGE_FSYNC=0 turns both off for a throughput-over-durability workload (a
// rebuildable mirror, a benchmark). The default is on: a database that loses an
// acknowledged write on power loss is not crash-safe, whatever the README says.
func gr_fsync_on() (yes) {
    yes = 1
    if env("GRANGE_FSYNC") == "0" { yes = 0 }
}

// gr_sync_dir makes recently created/removed directory entries durable. Call it
// after the write that defines a commit — one sync covers every entry created
// in that directory since the last one.
func gr_sync_dir() (ok) {
    ok = 1
    if gr_fsync_on() == 0 { return }
    if fsync(gr_dir()) < 0 { ok = 0 }
}

// gr_write_recfile writes lines + trailer to path. Returns 1 on success.
// The file's content is made durable before returning, so a caller that writes
// pages and then a manifest gets the ordering it depends on: the manifest can
// only become durable after the pages it names already are.
func gr_write_recfile(path, lines, nrecs) (ok) {
    ok = 0
    body := join(lines, "\n")
    full := body + "\n#|" + str(nrecs) + "|" + gr_chk(body) + "\n"
    if len(lines) == 0 { full = "#|0|" + gr_chk("") + "\n" }
    if write_file(path, full) < 0 { return }
    if gr_fsync_on() == 1 {
        if fsync(path) < 0 { return }
    }
    ok = 1
}

// gr_load_recfile reads and verifies a record file.
// Returns (lines-without-trailer, nrecs, ok).
func gr_load_recfile(path) (lines, nrecs, ok) {
    lines = []string{}
    nrecs = 0
    ok = 0
    content := read_file(path)
    if len(content) == 0 { return }
    raw := split(content, "\n")
    m := len(raw)
    if m > 0 && raw[m-1] == "" { m = m - 1 }
    if m < 1 { return }
    trailer := raw[m-1]
    if has_prefix(trailer, "#|") == false { return }
    parts := split(trailer, "|")
    if len(parts) != 3 { return }
    want_recs := parse_int(parts[1])
    i := 0
    while i < m-1 {
        lines = append(lines, raw[i])
        i = i + 1
    }
    // body is content minus "\n<trailer>\n" — substr beats re-joining the lines
    body := ""
    if m > 1 { body = substr(content, 0, len(content) - len(trailer) - 2) }
    if gr_chk(body) != parts[2] { return }
    nrecs = want_recs
    ok = 1
}

// gr_load_recbody reads + verifies a record file and returns its BODY as
// BYTES. Callers walk it with gr_next_line instead of materialising a per-line
// slice: in a long-lived actor every such slice stays in the arena (~70 kB per
// page read), which is fatal for disk-resident collections that read thousands
// of pages per scan or index build. Bytes (not string) because only
// bytes_index takes a start offset — searching a string would mean copying the
// remainder on every line, which is quadratic.
var g_nl = bytes("\n")

func gr_load_recbody(path) (body, ok) {
    body = bytes("")
    ok = 0
    // every page/chunk/index read in the engine passes through here, so this is
    // where a query's page cost is counted — instrumenting call sites instead
    // would miss whichever one gets added next
    q_cost_page()
    // read as bytes: no string->bytes copy, and sha256_bytes verifies in place
    raw := read_file_bytes(path)
    n := len(raw)
    if n == 0 { return }
    cut := n
    if byte_at(raw, cut - 1) == 10 { cut = cut - 1 }
    tstart := cut - 1
    while tstart >= 0 {
        if byte_at(raw, tstart) == 10 { break }
        tstart = tstart - 1
    }
    trailer := bytes_str(bytes_sub(raw, tstart + 1, cut))
    if has_prefix(trailer, "#|") == false { return }
    parts := split(trailer, "|")
    if len(parts) != 3 { return }
    cand := bytes("")
    if tstart > 0 { cand = bytes_sub(raw, 0, tstart) }
    if substr(to_hex(sha256_bytes(cand)), 0, 12) != parts[2] { return }
    body = cand
    ok = 1
}

// gr_count_lines counts newline-separated records WITHOUT materialising any
// line (pure index arithmetic): sizing a run must not cost a full copy of the
// batch.
func gr_count_lines(body) (n) {
    n = 0
    pos := 0
    total := len(body)
    while pos < total {
        nl := bytes_index(body, g_nl, pos)
        if nl < 0 {
            if total - pos > 0 { n = n + 1 }
            return
        }
        if nl - pos > 0 { n = n + 1 }
        pos = nl + 1
    }
}

// gr_next_line walks a body: (line, next position, more).
func gr_next_line(body, pos) (line, next, more) {
    line = ""
    next = pos
    more = 0
    n := len(body)
    if pos >= n { return }
    nl := bytes_index(body, g_nl, pos)
    if nl < 0 {
        line = bytes_str(bytes_sub(body, pos, n))
        next = n
        more = 1
        return
    }
    line = bytes_str(bytes_sub(body, pos, nl))
    next = nl + 1
    more = 1
}
