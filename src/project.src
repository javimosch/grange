// grange field projection — return only the fields the caller asked for.
//
// A caller could already say WHICH rows (--where), in WHAT ORDER (--order),
// HOW MANY (--limit) and WHERE TO RESUME (--after). The one thing they could
// not say is WHICH FIELDS, so every response carried whole documents.
//
// For an agent-first database that is not a nicety: the consumer is usually a
// model paying per token. Measured on the live analytics mirror, whose events
// carry 11 fields, asking for the 3 a dashboard needs took 5 rows from 1255
// bytes to 439 — 65% smaller, on every request, forever.
//
// Rules, chosen so a projected row is never a trap:
//
//   · `id` is ALWAYS returned. A row you cannot fetch again is worse than a
//     large row.
//   · a requested field the document does not have is OMITTED, not null —
//     grange does not invent structure, and `parse()` in machin treats a
//     missing field and a null field differently.
//   · a dotted path (user.id) projects under its FULL path as the key, flat.
//     Rebuilding {"user":{"id":..}} would be ambiguous the moment two paths
//     share a prefix, and flat keys round-trip through json_get unchanged.
//   · projection happens at emit time, so it composes with every plan: hot
//     scans, cold pages, index resolution, ordered walks and export all go
//     through the same helper.

var g_proj = []string{}

// proj_set parses the requested field list. Empty means "everything", which is
// the behaviour every existing caller already depends on.
func proj_set(spec) {
    g_proj = []string{}
    if len(trim(spec)) == 0 { return }
    parts := split(spec, ",")
    i := 0
    while i < len(parts) {
        f := trim(parts[i])
        // "id" is implicit; accepting it silently keeps ?fields=id,ts working
        if len(f) > 0 && f != "id" { g_proj = append(g_proj, f) }
        i = i + 1
    }
}

func proj_reset() {
    g_proj = []string{}
}

func proj_on() (yes) {
    yes = 0
    if len(g_proj) > 0 { yes = 1 }
}

// proj_doc reduces a document to the requested fields. With no projection set
// it returns the document unchanged — same pointer, no copy, so the common path
// costs nothing.
func proj_doc(doc) (out) {
    out = doc
    if len(g_proj) == 0 { return }
    parts := []string{}
    i := 0
    while i < len(g_proj) {
        tok := ix_field_tok(doc, g_proj[i])
        if len(tok) > 0 {
            parts = append(parts, "\"" + jesc(g_proj[i]) + "\":" + tok)
        }
        i = i + 1
    }
    out = "{" + join(parts, ",") + "}"
}
